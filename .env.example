# Copy to .env and edit. This file holds no secrets; see docs/configuration.md.

# Deployment identity; keep this unchanged after the first start.
COMPOSE_PROJECT_NAME=molebridge

# VPN provider: mullvad (default), pia or nordvpn. For PIA also set EXIT_IF=pia
# and COMPOSE_FILE=compose.yaml:compose.pia.yaml; for NordVPN (experimental),
# EXIT_IF=nordvpn and COMPOSE_FILE=compose.yaml:compose.nordvpn.yaml
# (docs/providers.md).
PROVIDER=mullvad
EXIT_IF=mullvad
# PIA only: forward one port to one overlay device. Off unless you need it.
PIA_PORT_FORWARD=off
PIA_PORT_FORWARD_TARGET=

# NetBird account's peer network range (required) and IPv6 overlay range (if enabled).
# Documentation-only example: replace with your account's actual range.
OVERLAY_CIDR=192.0.2.0/24
OVERLAY6_CIDR=

# NetBird peer name and management server (NetBird Cloud by default).
NB_HOSTNAME=molebridge-exit
NB_MANAGEMENT_URL=https://api.netbird.io

# Host user and group that own ./state (run `id -u` and `id -g`).
PUID=1000
PGID=1000
# The panel's user inside its container. Keep it equal to PUID:PGID on Docker;
# use 0:0 on a rootless engine that remaps uids (see docs/configuration.md).
PANEL_USER=1000:1000
TZ=Etc/UTC

# Panel, published on 127.0.0.1 only.
PANEL_PORT=8095
# Names the panel is served under, comma-separated: the public hostname behind
# your proxy and, if the proxy rewrites the upstream Host, that name with its
# port (e.g. host.docker.internal:8095). Loopback is always accepted.
PANEL_PUBLIC_HOSTS=exit.example.net
# Space-separated origins allowed to embed the panel, e.g. a dashboard:
# lowercase https://host, no port or path. Anything else is ignored.
PANEL_FRAME_ANCESTORS=
PANEL_HOST_LABEL=home
PANEL_HOME_URL=
PANEL_HOME_LABEL=Home
# auto follows each viewer's light/dark setting; set dark for an always-dark dashboard.
PANEL_THEME=auto
# provider: each provider's colours; dashboard: one neutral dashboard palette.
PANEL_STYLE=provider

# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
# Leave PANEL_OIDC_ISSUER empty for no login.
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=
PANEL_SESSION_TTL=3600

# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
GATUS_ENDPOINT=molebridge

# gluetun backend (experimental, docs/configuration.md#gluetun-backend): gluetun
# owns the tunnel instead of Molebridge. To use it, set COMPOSE_FILE=compose.gluetun.yaml
# and EXIT_IF=wg0 (letters, digits and underscores only) above. compose.yaml
# ignores everything below, and compose.gluetun.yaml ignores PROVIDER.
# gluetun's provider id, one the panel can select servers for: fastestvpn,
# ivpn, mullvad, nordvpn, surfshark or windscribe.
GLUETUN_PROVIDER=nordvpn
# The tunnel address your provider assigned, if it needs one (most do; NordVPN does not).
GLUETUN_WIREGUARD_ADDRESSES=
# The server gluetun starts with, comma-separated (see gluetun's provider
# pages); the panel's selection replaces it once you choose one. For the first
# start set only the country, your own (e.g. Netherlands): gluetun's built-in
# list may be old, and a hostname or city missing from it stops gluetun.
GLUETUN_SERVER_COUNTRIES=
GLUETUN_SERVER_CITIES=
GLUETUN_SERVER_HOSTNAMES=
# How often gluetun refreshes its server list, which the panel lists. The
# applier also asks for one refresh at start when the list is old; 0: never.
GLUETUN_UPDATER_PERIOD=24h
# The namespace's interface toward the host: eth0 on Docker; under rootless
# Podman with pasta, the host's own interface name.
HOST_IF=eth0
# Molebridge's copy of the host routes for NetBird's control traffic.
HOST_TABLE=51822
# NetBird's control-plane mark (NB_FWMARK_BASE). Change it only to move NetBird's whole mark range.
CONTROL_MARK=0x1bd00
# NetBird's WireGuard port, opened in gluetun's firewall.
NB_WIREGUARD_PORT=51820
