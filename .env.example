# Copy to .env and edit. This file holds no secrets; see docs/configuration.md.
# Every setting not listed here has a default in Molebridge and appears in
# compose.yaml as an override (docs/configuration.md).

# VPN provider: mullvad (default), pia or nordvpn (experimental). Keep it
# unchanged after installation (docs/providers.md).
PROVIDER=mullvad
# The tunnel interface, and the name of its config under tunnel/wg_confs/:
# the same as PROVIDER (mullvad, pia or nordvpn) unless you chose another name.
EXIT_IF=mullvad
# Optional server hostname (PIA: region id). When set, configuration wins:
# the exit ignores panel requests and the panel shows this exit read-only.
SERVER=
# PIA only: forward one port to one overlay device. Off unless you need it.
PIA_PORT_FORWARD=off
PIA_PORT_FORWARD_TARGET=

# NetBird account's peer network range (required) and IPv6 overlay range (if enabled).
# Documentation-only example: replace with your account's actual range.
OVERLAY_CIDR=192.0.2.0/24
OVERLAY6_CIDR=

# NetBird peer name and management server (NetBird Cloud by default).
NB_HOSTNAME=molebridge-exit
NB_MANAGEMENT_URL=https://api.netbird.io

# Switchyard, the panel, published on 127.0.0.1 only.
PANEL_PORT=8095
# Names the panel is served under, comma-separated: the public hostname behind
# your proxy and, if the proxy rewrites the upstream Host, that name with its
# port (e.g. host.docker.internal:8095). Loopback is always accepted.
PANEL_PUBLIC_HOSTS=exit.example.net
# Several exits in one panel, as id=provider[/kind][:label] (docs/switchyard.md).
# Empty: this exit only.
PANEL_EXITS=

# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
# Leave PANEL_OIDC_ISSUER empty for no login; with one, also set the three below.
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=

# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
TZ=Etc/UTC

# Overrides you may add, each documented with its default in
# docs/configuration.md: COMPOSE_PROJECT_NAME (keep it unchanged once the exit
# has started), PANEL_USER and PANEL_ALLOW_ROOT (a rootless engine that remaps
# uids), PANEL_TITLE, PANEL_HOST_LABEL, PANEL_THEME, PANEL_STYLE,
# PANEL_FRAME_ANCESTORS, PANEL_HOME_URL, PANEL_SESSION_TTL, OVERLAY_IF,
# EXIT_TABLE, ROUTING_RECONCILE_INTERVAL, GUARD_GRACE and GATUS_ENDPOINT.
