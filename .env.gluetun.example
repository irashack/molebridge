# Copy to .env for the gluetun backend (experimental, docs/configuration.md#gluetun-backend):
# gluetun owns the tunnel instead of Molebridge. This file holds no secrets.
# Not .env.example: compose.gluetun.yaml replaces compose.yaml and ignores PROVIDER.
COMPOSE_FILE=compose.gluetun.yaml

# gluetun's provider id, one the panel can select servers for: fastestvpn,
# ivpn, mullvad, nordvpn, surfshark or windscribe.
GLUETUN_PROVIDER=nordvpn
# gluetun's tunnel interface (VPN_INTERFACE): letters, digits and underscores.
# NetBird's ICE blacklist uses the same name.
EXIT_IF=wg0
# The tunnel address your provider assigned, if it needs one (most do; NordVPN does not).
GLUETUN_WIREGUARD_ADDRESSES=
# The server gluetun starts with, comma-separated (see gluetun's provider
# pages); SERVER takes over when set, otherwise the panel's selection does.
# For the first start set only the country, your own (e.g. Netherlands): gluetun's built-in
# list may be old, and a hostname or city missing from it stops gluetun.
GLUETUN_SERVER_COUNTRIES=
GLUETUN_SERVER_CITIES=
GLUETUN_SERVER_HOSTNAMES=
# Optional server hostname from gluetun's list. When set, configuration wins:
# the exit ignores panel requests and the panel shows the server read-only.
SERVER=
# The namespace's interface toward the host: eth0 on Docker; under rootless
# Podman with pasta, the host's own interface name.
HOST_IF=eth0

# NetBird account's peer network range (required) and IPv6 overlay range (if enabled).
# Documentation-only example: replace with your account's actual range.
OVERLAY_CIDR=192.0.2.0/24
OVERLAY6_CIDR=
# NetBird peer name and management server (NetBird Cloud by default).
NB_HOSTNAME=molebridge-exit
NB_MANAGEMENT_URL=https://api.netbird.io

# Switchyard, the panel, published on 127.0.0.1 only.
PANEL_PORT=8095
PANEL_PUBLIC_HOSTS=exit.example.net
# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
# Leave PANEL_OIDC_ISSUER empty for no login.
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=
# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
TZ=Etc/UTC

# Overrides you may add, each documented with its default in
# docs/configuration.md: GLUETUN_UPDATER_PERIOD, HOST_TABLE, CONTROL_MARK
# (NetBird's control-plane mark, NB_FWMARK_BASE), NB_WIREGUARD_PORT,
# FWMARK_GRACE, GUARD_GRACE, ROUTING_RECONCILE_INTERVAL, OVERLAY_IF,
# EXIT_TABLE, COMPOSE_PROJECT_NAME (keep it unchanged once the exit has
# started), PANEL_USER and PANEL_ALLOW_ROOT, and the PANEL_* styling settings.
