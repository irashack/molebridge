# shellcheck shell=sh
# Molebridge's routing contract for the gluetun backend, shared by the guard
# sidecar (routing/10-exit-routing) and NetBird's gate (routing/wait-for-guards)
# so both judge the namespace by the same code. Sourced, never run; the
# including script defines fail() and sets the settings below. Nothing here
# changes routing: the guard does that with its own commands.
#
# Settings: OVERLAY_CIDR, OVERLAY6_CIDR, OVERLAY_IF, EXIT_IF, EXIT_TABLE,
# HOST_IF, HOST_TABLE, CONTROL_MARK. gr_validate checks them and sets
# gr_shown4 and gr_shown6, the overlay ranges as iproute2 prints them.
#
# Priorities 0-97 and 102-104 belong to Molebridge. Expected, per family:
#   1  not iif <overlay> lookup local      local-delivery guard
#   88 iif lo fwmark <mark> lookup <host>  NetBird's control plane, host route
#   89 iif lo fwmark <mark> unreachable    ...and never gluetun's rule 101
#   90 iif <tunnel> to <overlay> lookup main
#   91 iif lo to <overlay> lookup main suppress_prefixlength 0
#   92 iif lo to <overlay> unreachable
#   94 from <tunnel address> ipproto icmp lookup <exit>
#   95 iif <overlay> lookup <exit>
#   96 oif <tunnel> lookup <exit>
#   97 iif <overlay> unreachable
#   (98-101 are gluetun's: local subnets, outbound subnets, inbound, and
#    101 `not fwmark 0xca6c lookup 51820`, its tunnel)
#   102 iif lo fwmark 0xca6c lookup main   gluetun's WireGuard socket
#   103 iif lo lookup <host> suppress_prefixlength 0   on-link host subnets
#   104 iif lo unreachable                 the exit's own traffic: kill switch
#   (105 and 110 are NetBird's)
# Rules 102-104 make gluetun's rule 101 the only way out for what the
# exit itself sends without a mark: when gluetun's tunnel table is empty, or
# rule 101 is gone while gluetun reconnects, that traffic is unreachable
# instead of falling through to the main table and the host's default
# route. gluetun's WireGuard socket carries mark 51820 (0xca6c; gluetun
# v3.41.3 fixes it: internal/wireguard/settings.go:64-66, and
# provider/utils/wireguard.go sets no other), which rule 101 skips, so rule
# 102 sends it to the main table. Rule 103 lets the exit reach HOST_IF's own
# subnets (the host table's on-link routes; its default is suppressed). The
# kernel checks a new route's gateway with a lookup that passes the policy
# rules as locally generated traffic, and gluetun adds `default via <gateway>
# dev eth0 table 200` at start before its own rule 98 for local subnets
# exists: without rule 103 that lookup reached 104 and failed with "network
# is unreachable", and gluetun gave up. The guard adds 104 only once 103 and
# the host table are in place. Loopback and the exit's own addresses are
# rule 1's local lookup.
# Rules 91 and 92 carry what the exit itself sends to the overlay, such as
# the ICMP errors (packet too big) it returns to clients: only NetBird's own
# overlay route in the main table may take it, never main's default route,
# and with no overlay route it fails instead of reaching gluetun's rule 101
# and the tunnel.
# Rules 90-92 exist for a family with an overlay range, rule 94 for a family in
# which the tunnel interface has an address. The exit table holds the
# permanent `unreachable default metric 4096` and, while the tunnel interface
# is up with an address in that family, `default dev <tunnel>`, nothing else.
# The host table holds exactly the main table's default and on-link routes
# through HOST_IF; IPv4 needs a default among them.

# gluetun's WireGuard fwmark, as iproute2 prints it (51820).
GLUETUN_MARK=0xca6c

gr_is_uint() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}
gr_valid_if() {
    case "$1" in ''|[!a-zA-Z0-9_]*|*[!a-zA-Z0-9_.-]*) return 1 ;; esac
    [ "${#1}" -le 15 ]
}
gr_valid_table() {
    gr_is_uint "$2" || fail "$1 must be numeric"
    case "$2" in 0*) fail "$1 must be canonical decimal" ;; esac
    [ "${#2}" -le 10 ] && [ "$2" -ge 256 ] && [ "$2" -le 2147483647 ] || fail "$1 must be 256..2147483647"
}

# An IPv6 prefix as iproute2 prints it (RFC 5952: lowercase, no leading
# zeroes, the leftmost longest run of two or more zero groups as ::), so rules
# can be compared with `ip -6 rule show`. Fails on anything else.
canonical_cidr6() {
    printf '%s\n' "$1" | awk -F/ '
    function bad() { failed = 1; exit 1 }
    {
        if (NF != 2) bad()
        address = tolower($1)
        if (address ~ /[^0-9a-f:]/) bad()
        n = 0
        split("", group)
        split("", left)
        split("", right)
        double = index(address, "::")
        if (double) {
            head = substr(address, 1, double - 1)
            tail = substr(address, double + 2)
            if (index(tail, "::")) bad()
            nl = head == "" ? 0 : split(head, left, ":")
            nr = tail == "" ? 0 : split(tail, right, ":")
            if (nl + nr > 7) bad()
            for (i = 1; i <= nl; i++) group[++n] = left[i]
            for (i = 0; i < 8 - nl - nr; i++) group[++n] = "0"
            for (i = 1; i <= nr; i++) group[++n] = right[i]
        } else {
            n = split(address, group, ":")
            if (n != 8) bad()
        }
        for (i = 1; i <= 8; i++) {
            if (group[i] == "" || length(group[i]) > 4) bad()
            sub(/^0+/, "", group[i])
            if (group[i] == "") group[i] = "0"
        }
        best = 0
        length_best = 0
        i = 1
        while (i <= 8) {
            if (group[i] != "0") { i++; continue }
            j = i
            while (j <= 8 && group[j] == "0") j++
            if (j - i > length_best) { best = i; length_best = j - i }
            i = j
        }
        text = ""
        if (length_best >= 2) {
            for (i = 1; i < best; i++) text = text (i > 1 ? ":" : "") group[i]
            text = text "::"
            for (i = best + length_best; i <= 8; i++) text = text group[i] (i < 8 ? ":" : "")
        } else {
            for (i = 1; i <= 8; i++) text = text (i > 1 ? ":" : "") group[i]
        }
        print text "/" $2
    }
    END { if (failed || NR != 1) exit 1 }'
}

# The overlay range as iproute2 prints it, or fail.
gr_shown_cidr4() {
    case "$1" in */*) : ;; *) fail "OVERLAY_CIDR must be an IPv4 CIDR" ;; esac
    gr_prefix=${1#*/}
    gr_is_uint "$gr_prefix" || fail "invalid IPv4 prefix"
    case "$gr_prefix" in 0*) fail "IPv4 default routes and leading zeroes are forbidden" ;; esac
    [ "${#gr_prefix}" -le 2 ] && [ "$gr_prefix" -le 32 ] || fail "invalid IPv4 prefix"
    gr_old_ifs=$IFS; IFS=.
    # Deliberate splitting; the including scripts disable globbing.
    # shellcheck disable=SC2086
    set -- ${1%/*}
    IFS=$gr_old_ifs
    [ "$#" -eq 4 ] || fail "IPv4 address needs four octets"
    gr_number=0
    for gr_octet in "$@"; do
        gr_is_uint "$gr_octet" || fail "invalid IPv4 octet"
        case "$gr_octet" in 0) : ;; 0*) fail "IPv4 leading zeroes are forbidden" ;; esac
        [ "${#gr_octet}" -le 3 ] && [ "$gr_octet" -le 255 ] || fail "invalid IPv4 octet"
        gr_number=$((gr_number * 256 + gr_octet))
    done
    [ $((gr_number % (1 << (32 - gr_prefix)))) -eq 0 ] || fail "OVERLAY_CIDR must use the network address"
    if [ "$gr_prefix" = 32 ]; then printf '%s.%s.%s.%s' "$1" "$2" "$3" "$4"; else printf '%s.%s.%s.%s/%s' "$1" "$2" "$3" "$4" "$gr_prefix"; fi
}

gr_validate() {
    gr_valid_if "$OVERLAY_IF" && gr_valid_if "$EXIT_IF" || fail "invalid interface name"
    [ "$OVERLAY_IF" != "$EXIT_IF" ] || fail "overlay and exit interfaces must differ"
    # gluetun accepts only these characters (internal/configuration/settings/
    # wireguard.go, regexpInterfaceName, v3.41.3).
    case "$EXIT_IF" in *[!a-zA-Z0-9_]*) fail "with gluetun, EXIT_IF may hold only letters, digits and underscores" ;; esac
    gr_valid_if "$HOST_IF" || fail "invalid HOST_IF"
    [ "$HOST_IF" != lo ] && [ "$HOST_IF" != "$OVERLAY_IF" ] && [ "$HOST_IF" != "$EXIT_IF" ] ||
        fail "HOST_IF must name the namespace's host interface, not lo, the overlay or the tunnel"
    gr_valid_table EXIT_TABLE "$EXIT_TABLE"
    gr_valid_table HOST_TABLE "$HOST_TABLE"
    [ "$HOST_TABLE" != "$EXIT_TABLE" ] || fail "HOST_TABLE and EXIT_TABLE must differ"
    for gr_table in "$EXIT_TABLE" "$HOST_TABLE"; do
        case "$gr_table" in 51820|7120) fail "tables 51820 (gluetun) and 7120 (NetBird) are taken" ;; esac
    done
    # NetBird's base leaves the low byte for its own offsets (client/net/fwmark.go).
    case "$CONTROL_MARK" in
        0x*[!0-9a-f]*) fail "CONTROL_MARK must be lowercase hexadecimal like 0x1bd00" ;;
        0x[1-9a-f]*00) [ "${#CONTROL_MARK}" -le 10 ] || fail "CONTROL_MARK must fit in 32 bits" ;;
        *) fail "CONTROL_MARK must be lowercase hexadecimal like 0x1bd00, low byte zero" ;;
    esac
    gr_shown4=$(gr_shown_cidr4 "$OVERLAY_CIDR") || exit 1
    gr_shown6=''
    if [ -n "$OVERLAY6_CIDR" ]; then
        case "$OVERLAY6_CIDR" in *:*/*) : ;; *) fail "OVERLAY6_CIDR must be an IPv6 CIDR" ;; esac
        gr_prefix6=${OVERLAY6_CIDR#*/}
        gr_is_uint "$gr_prefix6" && [ "${#gr_prefix6}" -le 3 ] && [ "$gr_prefix6" -ge 1 ] && [ "$gr_prefix6" -le 128 ] ||
            fail "invalid IPv6 prefix"
        gr_shown6=$(canonical_cidr6 "$OVERLAY6_CIDR") || fail "invalid OVERLAY6_CIDR"
        [ "$gr_prefix6" != 128 ] || gr_shown6=${gr_shown6%/*}
    fi
}

tunnel_up() {
    ip -o link show dev "$EXIT_IF" 2>/dev/null | grep -q '[<,]UP[,>]'
}

# The tunnel interface's first global address in the family, or nothing.
tunnel_address() {
    ip -o "$1" addr show dev "$EXIT_IF" scope global 2>/dev/null | awk '{
        for (i = 1; i < NF; i++) if ($i == "inet" || $i == "inet6") { a = $(i + 1); sub(/\/.*/, "", a); print a; exit }
    }'
}

# Molebridge's rules for one family as "priority:item|item|..." entries joined
# by ";". Items are what `ip rule show` prints, in any order. $2 is the tunnel
# address in the family or empty; $3 an extra entry or empty.
gluetun_expected() {
    gr_spec="1:not|from all|iif $OVERLAY_IF|lookup local"
    gr_spec="$gr_spec;88:from all|fwmark $CONTROL_MARK|iif lo|lookup $HOST_TABLE"
    gr_spec="$gr_spec;89:from all|fwmark $CONTROL_MARK|iif lo|unreachable"
    gr_shown=$gr_shown4
    gr_icmp=icmp
    if [ "$1" = -6 ]; then
        gr_shown=$gr_shown6
        gr_icmp=ipv6-icmp
    fi
    if [ -n "$gr_shown" ]; then
        gr_spec="$gr_spec;90:from all|to $gr_shown|iif $EXIT_IF|lookup main"
        gr_spec="$gr_spec;91:from all|to $gr_shown|iif lo|lookup main|suppress_prefixlength 0"
        gr_spec="$gr_spec;92:from all|to $gr_shown|iif lo|unreachable"
    fi
    [ -z "$2" ] || gr_spec="$gr_spec;94:from $2|ipproto $gr_icmp|lookup $EXIT_TABLE"
    gr_spec="$gr_spec;95:from all|iif $OVERLAY_IF|lookup $EXIT_TABLE"
    gr_spec="$gr_spec;96:from all|oif $EXIT_IF|lookup $EXIT_TABLE"
    gr_spec="$gr_spec;97:from all|iif $OVERLAY_IF|unreachable"
    gr_spec="$gr_spec;102:from all|fwmark $GLUETUN_MARK|iif lo|lookup main"
    gr_spec="$gr_spec;103:from all|iif lo|lookup $HOST_TABLE|suppress_prefixlength 0"
    gr_spec="$gr_spec;104:from all|iif lo|unreachable"
    [ -z "$3" ] || gr_spec="$gr_spec;$3"
    printf '%s' "$gr_spec"
}

# Compares `ip rule show` for Molebridge's priorities (0-97, 102-104) with
# the expected rules. Prints
# "add <priority>" for each missing rule and, for every other rule in that
# range, "del <priority> <selectors>", or "sub <priority> <selectors>" when
# the rule's selectors are a subset of the expected rule's: the kernel deletes
# the first rule that has every given attribute, which could then be the
# expected one. Nothing printed means exactly the expected rules.
rule_actions() {
    gr_rules=$(ip "$1" rule show 2>/dev/null) || { echo "unreadable"; return 0; }
    printf '%s\n' "$gr_rules" | awk -v spec="$2" '
    BEGIN {
        n = split(spec, entries, ";")
        for (i = 1; i <= n; i++) {
            p = entries[i]
            sub(/:.*/, "", p)
            want[p] = substr(entries[i], length(p) + 2)
        }
    }
    NF == 0 { next }
    $1 !~ /^[0-9]+:$/ { print "unparsed"; next }
    {
        priority = $1
        sub(/:$/, "", priority)
        priority += 0
        if (priority > 97 && (priority < 102 || priority > 104)) next
        line = ""
        for (i = 2; i <= NF; i++) if ($i != "[detached]") line = line " " $i
        m = split(substr(line, 2), token, " ")
        split("", have)
        count = 0
        for (i = 1; i <= m; i++) {
            if (token[i] ~ /^(not|unreachable|prohibit|blackhole|nop)$/) {
                item = token[i]
            } else {
                value = token[i + 1]
                if (token[i] == "ipproto" && value == "1") value = "icmp"
                if (token[i] == "ipproto" && value == "58") value = "ipv6-icmp"
                item = token[i] " " value
                i++
            }
            if (!(item in have)) count++
            have[item] = 1
        }
        key = priority ""
        if (!(key in want)) { print "del " priority line; next }
        k = split(want[key], wanted, "|")
        split("", expected)
        for (j = 1; j <= k; j++) expected[wanted[j]] = 1
        covered = 1
        for (item in have) if (!(item in expected)) covered = 0
        if (covered && count == k && !(key in kept)) kept[key] = 1
        else print (covered ? "sub " : "del ") priority line
    }
    END {
        # Terminal rules first, so nothing falls through while the rest go in.
        # 102 and 103, the exceptions, before 104, which would block them.
        n = split("97 89 92 102 103 104 1 80 88 90 91 94 95 96", order, " ")
        for (i = 1; i <= n; i++) if ((order[i] in want) && !(order[i] in kept)) print "add " order[i]
    }'
}

# Exit table: prints "fallback" or "tunnel" for a missing route and "del
# <selectors>" for any other route. $2 is 1 when a tunnel default belongs.
exit_table_actions() {
    gr_routes=$(ip "$1" route show table "$EXIT_TABLE" 2>/dev/null) || gr_routes=''
    printf '%s\n' "$gr_routes" | awk -v dev="$EXIT_IF" -v tunnel="$2" '
    NF == 0 { next }
    $1 == "nexthop" { next }
    {
        via = 0
        d = ""
        metric = ""
        for (i = 2; i < NF; i++) {
            if ($i == "via") via = 1
            if ($i == "dev") d = $(i + 1)
            if ($i == "metric") metric = $(i + 1)
        }
        if ($1 == "unreachable" && $2 == "default" && metric == "4096" && !fallback) { fallback = 1; next }
        if ($1 == "default" && d == dev && !via && tunnel == 1 && !found) { found = 1; next }
        start = 1
        selector = ""
        if ($1 ~ /^(unicast|unreachable|blackhole|prohibit|throw|local|broadcast|multicast|anycast|nat)$/) {
            selector = $1 " "
            start = 2
        }
        selector = selector $start
        for (i = start + 1; i < NF; i++) {
            if ($i == "via" && ($(i + 1) == "inet" || $(i + 1) == "inet6")) { selector = selector " via " $(i + 1) " " $(i + 2); i += 2 }
            else if ($i ~ /^(via|dev|metric|tos)$/) { selector = selector " " $i " " $(i + 1); i++ }
        }
        print "del " selector
    }
    END {
        if (!fallback) print "fallback"
        if (tunnel == 1 && !found) print "tunnel"
    }'
}

# Default and on-link routes through HOST_IF, one per line and sorted, on-link
# first so a gateway is reachable when its default route goes in. With
# "check", anything else in the table prints as "x".
host_routes() {
    ip "$1" route show table "$2" 2>/dev/null | awk -v dev="$HOST_IF" -v mode="$3" '
    $1 == "nexthop" { next }
    {
        start = 1
        if ($1 == "unicast") start = 2
        else if ($1 ~ /^(unreachable|blackhole|prohibit|throw|local|broadcast|multicast|anycast|nat)$/) {
            if (mode == "check") print "x"
            next
        }
        dst = $start
        via = "-"
        src = "-"
        metric = "-"
        onlink = "-"
        d = ""
        odd = 0
        for (i = start + 1; i <= NF; i++) {
            if ($i == "via") { if ($(i + 1) == "inet" || $(i + 1) == "inet6") odd = 1; via = $(i + 1); i++ }
            else if ($i == "dev") { d = $(i + 1); i++ }
            else if ($i == "src") { src = $(i + 1); i++ }
            else if ($i == "metric") { metric = $(i + 1); i++ }
            else if ($i == "onlink") onlink = "onlink"
            else if ($i == "nhid" || $i == "encap") odd = 1
        }
        if (d != dev || odd || (via != "-" && dst != "default")) {
            if (mode == "check") print "x"
            next
        }
        kind = via == "-" ? 0 : 1
        print kind, dst, via, src, metric, onlink
    }' | sort
}

# What is wrong with one family, one word per problem, nothing when the whole
# contract holds: "rules" (anything at 0-97 or 102-104 differs from the
# expected set),
# "exit" (the exit table), "host" (the host table differs from main's host
# routes), "nodefault" (IPv4 without a default through HOST_IF). $2 is an
# extra expected rule or empty. Sets gr_address and gr_tunnel.
gr_problems() {
    gr_address=$(tunnel_address "$1")
    gr_tunnel=0
    if [ -n "$gr_address" ] && tunnel_up; then gr_tunnel=1; fi
    [ -z "$(rule_actions "$1" "$(gluetun_expected "$1" "$gr_address" "$2")")" ] || echo rules
    [ -z "$(exit_table_actions "$1" "$gr_tunnel")" ] || echo exit
    gr_host=$(host_routes "$1" "$HOST_TABLE" check)
    if [ "$gr_host" != "$(host_routes "$1" main main)" ]; then
        echo host
    elif [ "$1" = -4 ] && ! printf '%s\n' "$gr_host" | awk '$2 == "default" { f = 1 } END { exit !f }'; then
        echo nodefault
    fi
}

# The guard's records and the gate's deadlines use the kernel's boot clock
# (/proc/uptime), which wall-clock changes do not move, with the boot's
# identity, so a record from an earlier boot never counts. Containers share
# both with the host kernel. Sets gr_boot and gr_now (whole seconds), or
# returns non-zero.
gr_clock() {
    gr_boot=''
    gr_now=''
    { read -r gr_boot < "${MOLEBRIDGE_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"; } 2>/dev/null || return 1
    { read -r gr_now _ < "${MOLEBRIDGE_UPTIME_FILE:-/proc/uptime}"; } 2>/dev/null || return 1
    gr_now=${gr_now%%.*}
    case "$gr_boot" in *[!0-9a-f-]*|'') return 1 ;; esac
    [ "${#gr_boot}" -le 64 ] && gr_is_uint "$gr_now" && [ "${#gr_now}" -le 12 ]
}
