#!/usr/bin/env sh
# Install Molebridge's namespace routing before the overlay can start.
# Priority 1 replaces the kernel's priority-0 `lookup local` rule with one that
# skips packets arriving on the overlay interface, so overlay traffic is never
# delivered to this host: every overlay packet falls through to rules 90-97.
# Loopback and every other interface keep local delivery.
# Priority 80 blocks forwarded traffic while rules are being rebuilt.
# Priority 94 routes the exit's own ICMP errors, sourced from the tunnel
# address, back through the tunnel instead of the host's default route. It
# matches ICMP only, so other traffic a co-located process sources from that
# address keeps the namespace's ordinary route.
# Priority 97 is a permanent terminal guard if lookup 95 or its routes vanish.
# Priority 98 is the backstop behind 94: tunnel-sourced ICMP is unreachable if
# 94 is missing, or if the exit table is empty while the tunnel is down.
#
# The native backend (TUNNEL_BACKEND=wireguard, the default) is driven by the
# routing image's entrypoint, routing/molebridge-exit: `--install` installs
# the contract once, before the tunnel exists, and `--reconcile` makes one
# repair pass. Neither touches the readiness marker; the entrypoint owns it.
# Run without arguments, the script installs and then sets the marker, as it
# did as a LinuxServer init script.
#
# TUNNEL_BACKEND=gluetun runs the same contract as a sidecar in gluetun's
# namespace, adds NetBird's control-plane rules (88/89) and a host table, and
# keeps everything in place in a loop; see the gluetun section below and
# docs/architecture.md#gluetun-backend.
set -eu
set -f

OVERLAY_CIDR="${OVERLAY_CIDR:-}"
OVERLAY6_CIDR="${OVERLAY6_CIDR:-}"
OVERLAY_IF="${OVERLAY_IF:-wt0}"
EXIT_IF="${EXIT_IF:-mullvad}"
EXIT_TABLE="${EXIT_TABLE:-51821}"
PROVIDER="${PROVIDER:-mullvad}"
READY_FILE="${ROUTING_READY_FILE:-/run/molebridge-routing-ready}"
TUNNEL_BACKEND="${TUNNEL_BACKEND:-wireguard}"
# A single gluetun reconcile pass leaves the marker for the pass to decide;
# the native modes leave it to the entrypoint.
case "$TUNNEL_BACKEND:${1:-}" in
    gluetun:--reconcile|wireguard:--install|wireguard:--reconcile) : ;;
    *) rm -f "$READY_FILE" ;;
esac

fail() { echo "10-exit-routing: $1" >&2; exit 1; }
is_uint() {
    case "$1" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac
}
valid_if() {
    case "$1" in ''|[!a-zA-Z0-9_]*|*[!a-zA-Z0-9_.-]*) return 1 ;; esac
    [ "${#1}" -le 15 ]
}
# Sets address_num for the caller; fails on anything but a canonical address.
parse_ipv4() {
    old_ifs=$IFS; IFS=.
    # Deliberate splitting; globbing is disabled above.
    # shellcheck disable=SC2086
    set -- $1
    IFS=$old_ifs
    [ "$#" -eq 4 ] || fail "IPv4 address needs four octets"
    address_num=0
    for octet in "$@"; do
        is_uint "$octet" || fail "invalid IPv4 octet"
        case "$octet" in 0) : ;; 0*) fail "IPv4 leading zeroes are forbidden" ;; esac
        [ "${#octet}" -le 3 ] && [ "$octet" -le 255 ] || fail "invalid IPv4 octet"
        address_num=$((address_num * 256 + octet))
    done
}
# True when the family already has exactly this script's local-delivery rule.
# iproute2 marks the selector detached until NetBird creates the interface.
local_guard_present() {
    ip "$1" rule show | awk -v iface="$OVERLAY_IF" '
        $1 == "1:" && $2 == "not" && $3 == "from" && $4 == "all" && $5 == "iif" && $6 == iface {
            if ((NF == 8 && $7 == "lookup" && $8 == "local") ||
                (NF == 9 && $7 == "[detached]" && $8 == "lookup" && $9 == "local")) found = 1
        }
        END { exit !found }
    '
}
valid_if "$OVERLAY_IF" && valid_if "$EXIT_IF" || fail "invalid interface name"
[ "$OVERLAY_IF" != "$EXIT_IF" ] || fail "overlay and exit interfaces must differ"
is_uint "$EXIT_TABLE" || fail "EXIT_TABLE must be numeric"
case "$EXIT_TABLE" in 0*) fail "EXIT_TABLE must be canonical decimal" ;; esac
[ "${#EXIT_TABLE}" -le 10 ] && [ "$EXIT_TABLE" -ge 256 ] && [ "$EXIT_TABLE" -le 2147483647 ] || fail "EXIT_TABLE must be 256..2147483647"

case "$OVERLAY_CIDR" in */*) : ;; *) fail "OVERLAY_CIDR must be an IPv4 CIDR" ;; esac
addr=${OVERLAY_CIDR%/*}
prefix=${OVERLAY_CIDR#*/}
is_uint "$prefix" || fail "invalid IPv4 prefix"
case "$prefix" in 0*) fail "IPv4 default routes and leading zeroes are forbidden" ;; esac
[ "${#prefix}" -le 2 ] && [ "$prefix" -le 32 ] || fail "invalid IPv4 prefix"
parse_ipv4 "$addr"
host_bits=$((32 - prefix))
[ $((address_num % (1 << host_bits))) -eq 0 ] || fail "OVERLAY_CIDR must use the network address"
if [ -n "$OVERLAY6_CIDR" ]; then
    case "$OVERLAY6_CIDR" in *:*/*) : ;; *) fail "OVERLAY6_CIDR must be an IPv6 CIDR" ;; esac
    prefix6=${OVERLAY6_CIDR#*/}
    is_uint "$prefix6" || fail "invalid IPv6 prefix"
    [ "${#prefix6}" -le 3 ] && [ "$prefix6" -ge 1 ] && [ "$prefix6" -le 128 ] || fail "invalid IPv6 prefix"
fi

# Local delivery first: the new rule goes in before the kernel's rule 0 comes
# out, so loopback and the host interface never lose it. The local table and
# its routes stay. A rerun finds rule 1 in place and rule 0 already gone.
install_local_guard() {
    for family in -4 -6; do
        if ! local_guard_present "$family"; then
            ip "$family" rule add not iif "$OVERLAY_IF" lookup local priority 1
        fi
        while ip "$family" rule del priority 0 2>/dev/null; do :; done
    done
}

# ---------------------------------------------------------------------------
# gluetun backend. gluetun owns the namespace and creates the tunnel interface
# (EXIT_IF) itself, again on every reconnect, so this runs as a supervised
# sidecar in its namespace: it installs the rules once, then reconciles every
# ROUTING_RECONCILE_INTERVAL seconds. gluetun's own rules (98 local subnets,
# 99 outbound subnets, 100 inbound, 101 `not fwmark 51820 lookup 51820`) and
# NetBird's (105, 110) are left alone. Priorities 0-97 and 102-104 belong
# to Molebridge here: anything else at those priorities is removed. 102-104
# sit between gluetun's 101 and NetBird's 105 so that the exit's own
# unmarked traffic leaves only through gluetun's tunnel, or not at all. The
# expected rules, exit table and host table are defined in routing/contract-rules,
# which NetBird's gate reads too, so both judge the namespace the same way.
# The mark is exact (mask 0xffffffff) and `iif lo` limits 88/89 to locally
# generated packets, so forwarded packets carrying NetBird's data-plane marks
# never match.
# ---------------------------------------------------------------------------
CONTROL_MARK="${CONTROL_MARK:-0x1bd00}"
HOST_IF="${HOST_IF:-eth0}"
HOST_TABLE="${HOST_TABLE:-51822}"
STATUS_FILE="${GUARD_STATUS_FILE:-}"
INTERVAL="${ROUTING_RECONCILE_INTERVAL:-2}"
# How often the fwmark record is rewritten, whatever INTERVAL is. NetBird's
# gate allows at least FWMARK_GRACE >= 5 seconds between good records.
STATUS_INTERVAL=2
# The rule set, its checks and the clock, shared with NetBird's gate.
# GLUETUN_RULES is the setting's name before 0.6.0.
CONTRACT_RULES="${CONTRACT_RULES:-${GLUETUN_RULES:-/usr/local/lib/molebridge/contract-rules}}"

load_contract() {
    [ -f "$CONTRACT_RULES" ] || fail "the shared rule definitions are missing ($CONTRACT_RULES)"
    # shellcheck source=routing/contract-rules
    . "$CONTRACT_RULES"
}

gluetun_validate() {
    load_contract
    gr_validate
    gr_is_uint "$INTERVAL" && [ "${#INTERVAL}" -le 2 ] && [ "$INTERVAL" -ge 1 ] && [ "$INTERVAL" -le 60 ] ||
        fail "ROUTING_RECONCILE_INTERVAL must be 1..60 seconds"
}

# gluetun_rule add|del <family> <priority> [<at priority>]: the expected rule
# for <priority>, placed at <at priority> (default the same).
gluetun_rule() {
    rule_verb=$1
    rule_family=$2
    rule_at=${4:-$3}
    case "$3" in
        1) set -- not iif "$OVERLAY_IF" lookup local ;;
        80) set -- iif "$OVERLAY_IF" unreachable ;;
        88) set -- iif lo fwmark "$CONTROL_MARK/0xffffffff" lookup "$HOST_TABLE" ;;
        89) set -- iif lo fwmark "$CONTROL_MARK/0xffffffff" unreachable ;;
        90)
            cidr=$OVERLAY_CIDR
            [ "$rule_family" = -4 ] || cidr=$OVERLAY6_CIDR
            set -- iif "$EXIT_IF" to "$cidr" lookup main ;;
        91|92)
            cidr=$OVERLAY_CIDR
            [ "$rule_family" = -4 ] || cidr=$OVERLAY6_CIDR
            if [ "$3" = 91 ]; then
                set -- iif lo to "$cidr" lookup main suppress_prefixlength 0
            else
                set -- iif lo to "$cidr" unreachable
            fi ;;
        94)
            icmp=icmp
            [ "$rule_family" = -4 ] || icmp=ipv6-icmp
            set -- from "$gl_address" ipproto "$icmp" lookup "$EXIT_TABLE" ;;
        98)
            icmp=icmp
            [ "$rule_family" = -4 ] || icmp=ipv6-icmp
            set -- from "$gl_address" ipproto "$icmp" unreachable ;;
        95) set -- iif "$OVERLAY_IF" lookup "$EXIT_TABLE" ;;
        96) set -- oif "$EXIT_IF" lookup "$EXIT_TABLE" ;;
        97) set -- iif "$OVERLAY_IF" unreachable ;;
        102) set -- iif lo fwmark "$GLUETUN_MARK/0xffffffff" lookup main ;;
        103) set -- iif lo lookup "$HOST_TABLE" suppress_prefixlength 0 ;;
        104) set -- iif lo unreachable ;;
        *) return 1 ;;
    esac
    ip "$rule_family" rule "$rule_verb" "$@" priority "$rule_at"
}

# Replaces everything at a priority with its expected rule without a gap: a
# copy goes in one priority earlier, the priority is cleared and refilled,
# then the copy goes. Each copy's selectors or action differ from the
# expected rule at that earlier priority, so removing it cannot take that one.
repair_priority() {
    previous=$(($2 - 1))
    gluetun_rule add "$1" "$2" "$previous" 2>/dev/null || :
    cleared=0
    while [ "$cleared" -lt 32 ] && ip "$1" rule del priority "$2" 2>/dev/null; do cleared=$((cleared + 1)); done
    gluetun_rule add "$1" "$2" || echo "10-exit-routing: could not restore IPv${1#-} rule $2" >&2
    gluetun_rule del "$1" "$2" "$previous" 2>/dev/null || :
    [ "$gl_quiet" = 1 ] || echo "10-exit-routing: rebuilt IPv${1#-} rule $2"
}

# Missing rules go in before anything is removed, and rule 1 exists before
# the kernel's rule 0 goes. A correct rule is removed only inside
# repair_priority, behind its copy, so rules 94 and 98 are never both gone.
# $3 is "hold" to keep the gluetun kill switch out; $4 and $5 are
# rule_actions' mode and priorities to leave alone.
apply_rule_actions() {
    actions=$(rule_actions "$1" "$2" "${4:-gluetun}" "${5:-}")
    printf '%s\n' "$actions" | while read -r verb priority _; do
        [ "$verb" = add ] || continue
        # The kill switch waits for its exceptions' table ($3 = hold).
        [ "$priority:${3:-}" != 104:hold ] || continue
        if gluetun_rule add "$1" "$priority"; then
            [ "$gl_quiet" = 1 ] || echo "10-exit-routing: added IPv${1#-} rule $priority"
        fi
    done
    repaired=' '
    printf '%s\n' "$actions" | while read -r verb priority selectors; do
        case "$verb" in
            sub)
                case "$repaired" in *" $priority "*) continue ;; esac
                repaired="$repaired$priority "
                repair_priority "$1" "$priority" ;;
            del)
                # iproute2's own printout of the rule; splitting is deliberate
                # and globbing is off.
                # shellcheck disable=SC2086
                if ip "$1" rule del priority "$priority" $selectors 2>/dev/null; then
                    [ "$gl_quiet" = 1 ] || echo "10-exit-routing: removed IPv${1#-} rule $priority: $selectors"
                else
                    echo "10-exit-routing: could not remove IPv${1#-} rule $priority: $selectors" >&2
                fi ;;
        esac
    done
}

apply_exit_table() {
    actions=$(exit_table_actions "$1" "$2")
    case "$actions" in
        *fallback*)
            if ip "$1" route replace unreachable default metric 4096 table "$EXIT_TABLE"; then
                [ "$gl_quiet" = 1 ] || echo "10-exit-routing: IPv${1#-} unreachable fallback in table $EXIT_TABLE restored"
            fi ;;
    esac
    case "$actions" in
        *tunnel*)
            if ip "$1" route replace default dev "$EXIT_IF" table "$EXIT_TABLE"; then
                [ "$gl_quiet" = 1 ] || echo "10-exit-routing: IPv${1#-} tunnel route through $EXIT_IF restored"
            fi ;;
    esac
    printf '%s\n' "$actions" | while read -r verb selectors; do
        [ "$verb" = del ] || continue
        # shellcheck disable=SC2086
        ip "$1" route del $selectors table "$EXIT_TABLE" 2>/dev/null ||
            echo "10-exit-routing: could not remove an IPv${1#-} route from table $EXIT_TABLE" >&2
    done
}

# Makes the host table equal to the main table's host routes. A difference
# flushes and refills it; meanwhile control traffic hits rule 89 and fails.
refresh_host_table() {
    want=$(host_routes "$1" main main)
    [ "$want" != "$(host_routes "$1" "$HOST_TABLE" check)" ] || return 0
    ip "$1" route flush table "$HOST_TABLE" 2>/dev/null || :
    printf '%s\n' "$want" | while read -r _ dst via src metric onlink; do
        [ -n "$dst" ] || continue
        set -- "$1" route replace "$dst"
        [ "$via" = - ] || set -- "$@" via "$via"
        set -- "$@" dev "$HOST_IF"
        [ "$src" = - ] || set -- "$@" src "$src"
        [ "$metric" = - ] || set -- "$@" metric "$metric"
        [ "$onlink" = - ] || set -- "$@" onlink
        ip "$@" table "$HOST_TABLE" ||
            echo "10-exit-routing: could not copy a host route into table $HOST_TABLE" >&2
    done
    [ "$gl_quiet" = 1 ] || echo "10-exit-routing: IPv${1#-} host table $HOST_TABLE refreshed from $HOST_IF"
}

# NetBird's gate reads this to check the overlay interface's fwmark; its
# image has no `wg`. One line, "<boot id> <boot-clock seconds> <fwmark>",
# with "absent" when there is no WireGuard interface. The gate trusts a
# record only from this boot and not from its future, and only for its own
# time since the record was written.
write_status() {
    [ -n "$STATUS_FILE" ] || return 0
    value=$(wg show "$OVERLAY_IF" fwmark 2>/dev/null) || value=absent
    case "$value" in off|0x[0-9a-f]*) : ;; *) value=absent ;; esac
    case "$value" in 0x*[!0-9a-f]*) value=absent ;; esac
    if ! gr_clock; then
        echo "10-exit-routing: cannot read the boot clock; no fwmark record written" >&2
        return 0
    fi
    if ! { printf '%s %s %s\n' "$gr_boot" "$gr_now" "$value" > "$STATUS_FILE.tmp" && mv -f "$STATUS_FILE.tmp" "$STATUS_FILE"; }; then
        echo "10-exit-routing: cannot write $STATUS_FILE" >&2
    fi
}

# One pass over both families. Never relies on errexit: every failure only
# withholds readiness. $1 is an extra expected rule (the temporary 80 while
# installing); gl_mark sets whether the readiness marker follows the result.
# Readiness is judged by gr_problems, the same check NetBird's gate makes.
gluetun_pass() {
    gl_rules_ok=1
    gl_ready=1
    gl_report=''
    for gl_family in -4 -6; do
        gl_address=$(tunnel_address "$gl_family")
        gl_tunnel=0
        if [ -n "$gl_address" ] && tunnel_up; then gl_tunnel=1; fi
        gl_name="IPv${gl_family#-}"
        # The host table first: rule 103 needs it before rule 104 may go in.
        refresh_host_table "$gl_family"
        gl_hold=''
        if [ "$(host_routes "$gl_family" "$HOST_TABLE" check)" != "$(host_routes "$gl_family" main main)" ]; then
            gl_hold=hold
        fi
        gl_spec=$(gluetun_expected "$gl_family" "$gl_address" "$1")
        apply_rule_actions "$gl_family" "$gl_spec" "$gl_hold"
        apply_exit_table "$gl_family" "$gl_tunnel"
        for gl_problem in $(gr_problems "$gl_family" "$1"); do
            gl_ready=0
            case "$gl_problem" in
                rules)
                    if [ -n "$gl_hold" ] && [ -z "$(rule_actions "$gl_family" "$gl_spec" | grep -v '^[a-z]* 104\( \|$\)')" ]; then
                        gl_report="$gl_report $gl_name kill switch (rule 104) held until host table $HOST_TABLE has $HOST_IF's routes;"
                    else
                        gl_rules_ok=0
                        gl_report="$gl_report $gl_name rules;"
                    fi ;;
                exit) gl_rules_ok=0; gl_report="$gl_report $gl_name exit table $EXIT_TABLE;" ;;
                host) gl_report="$gl_report $gl_name host table $HOST_TABLE;" ;;
                nodefault) gl_report="$gl_report no IPv4 default route through $HOST_IF in the main table (if $HOST_IF lost it, or gluetun was restarted into a new namespace, recreate the stack: tools/molebridge.py recover);" ;;
            esac
        done
    done
    if ! ip link show dev "$HOST_IF" >/dev/null 2>&1; then
        gl_ready=0
        gl_report="$gl_report $HOST_IF is not in this namespace (gluetun restarted into a new one? recreate the stack: tools/molebridge.py recover);"
    fi
    write_status
    if [ "$gl_mark" = 1 ]; then
        if [ "$gl_ready" = 1 ]; then touch "$READY_FILE"; else rm -f "$READY_FILE"; fi
    fi
    if [ "$gl_quiet" != 1 ] && [ "$gl_report" != "${gl_last_report-unset}" ]; then
        if [ -z "$gl_report" ]; then
            echo "10-exit-routing: every rule and route in place (1/88/89/90/91/92/94/95/96/97/102/103/104, exit table $EXIT_TABLE, host table $HOST_TABLE)"
        else
            echo "10-exit-routing: not ready:$gl_report" >&2
        fi
        gl_last_report=$gl_report
    fi
}

gluetun_main() {
    gluetun_validate
    case "${1:-}" in ''|--once|--reconcile) : ;; *) fail "unknown argument (use --once or --reconcile)" ;; esac
    if [ "$(cat /proc/sys/net/ipv4/icmp_errors_use_inbound_ifaddr 2>/dev/null)" != 1 ]; then
        echo "10-exit-routing: warning: net.ipv4.icmp_errors_use_inbound_ifaddr is not 1; set it on the gluetun service or IPv4 path MTU discovery through the exit will fail" >&2
    fi
    trap 'exit 0' INT TERM
    gl_mark=1
    gl_quiet=0
    if [ "${1:-}" != --reconcile ]; then
        install_local_guard
        # Never remove the temporary guard if anything below fails.
        for family in -4 -6; do
            while ip "$family" rule del iif "$OVERLAY_IF" unreachable priority 80 2>/dev/null; do :; done
            ip "$family" rule add iif "$OVERLAY_IF" unreachable priority 80
            ip "$family" route replace unreachable default metric 4096 table "$EXIT_TABLE"
        done
        gl_mark=0
        gl_quiet=1
        gluetun_pass "80:from all|iif $OVERLAY_IF|unreachable" || :
        [ "$gl_rules_ok" = 1 ] || fail "rules could not be installed:$gl_report the temporary guard (priority 80) stays"
        for family in -4 -6; do
            while ip "$family" rule del iif "$OVERLAY_IF" unreachable priority 80 2>/dev/null; do :; done
        done
        gl_mark=1
        gl_quiet=0
        unset gl_last_report
    fi
    gluetun_pass '' || :
    case "${1:-}" in --once|--reconcile) [ "$gl_ready" = 1 ]; return ;; esac
    # The fwmark record every STATUS_INTERVAL seconds, so NetBird's gate
    # always has a fresh one; a full pass every INTERVAL seconds. Both on the
    # boot clock.
    gr_clock || gr_now=0
    gl_next=$((gr_now + INTERVAL))
    while :; do
        sleep "$STATUS_INTERVAL" &
        wait "$!" || :
        if gr_clock && [ "$gr_now" -lt "$gl_next" ]; then
            write_status
            continue
        fi
        gluetun_pass '' || :
        gr_clock || gr_now=0
        gl_next=$((gr_now + INTERVAL))
    done
}

if [ "$TUNNEL_BACKEND" = gluetun ]; then
    gluetun_main "$@"
    exit 0
elif [ "$TUNNEL_BACKEND" != wireguard ]; then
    fail "TUNNEL_BACKEND must be wireguard or gluetun"
fi

# ---------------------------------------------------------------------------
# Native backend.
# ---------------------------------------------------------------------------

# One reconcile pass for the entrypoint (routing/molebridge-exit), which
# passes the tunnel config's canonical addresses in MOLEBRIDGE_ADDR4 and
# MOLEBRIDGE_ADDR6 (empty for none), MOLEBRIDGE_RULE94 (conf, or applier when
# the config has no address and the applier owns rules 94 and 98) and
# MOLEBRIDGE_TUNNEL_STARTING=1 while `wg-quick up` runs. Missing rules and
# routes go back, anything else in Molebridge's priorities 0-98 or the exit
# table goes. A change to rules 90-97 happens behind the temporary guard at
# priority 80, which comes out once the result verifies; while it can't be
# verified the guard stays, and a later pass that finds everything else right
# takes it out. Exit status: 0 when everything was in place, 3 when it is
# after repairs, 1 when something is still wrong.
native_reconcile() {
    load_contract
    gr_validate_common
    nr_addr4=${MOLEBRIDGE_ADDR4:-}
    nr_addr6=${MOLEBRIDGE_ADDR6:-}
    nr_rule94=${MOLEBRIDGE_RULE94:-conf}
    case "$nr_addr4" in *[!0-9.]*) fail "invalid MOLEBRIDGE_ADDR4" ;; esac
    case "$nr_addr6" in *[!0-9a-f:]*) fail "invalid MOLEBRIDGE_ADDR6" ;; esac
    case "$nr_rule94" in conf|applier) : ;; *) fail "MOLEBRIDGE_RULE94 must be conf or applier" ;; esac
    [ "$nr_rule94" = conf ] || [ -z "$nr_addr4$nr_addr6" ] || fail "an addressless config has no addresses"
    nr_skip=''
    [ "$nr_rule94" = conf ] || nr_skip='94 98'
    window="80:from all|iif $OVERLAY_IF|unreachable"
    gl_quiet=0
    nr_changed=0
    nr_bad=0
    for nr_family in -4 -6; do
        gl_address=$nr_addr4
        [ "$nr_family" = -4 ] || gl_address=$nr_addr6
        # The tunnel carries IPv4 always (an addressless config's hooks route
        # it too) and IPv6 when the config has an IPv6 address.
        nr_tunnel=0
        if [ "${MOLEBRIDGE_TUNNEL_STARTING:-0}" = 1 ]; then
            nr_tunnel=2
        elif tunnel_up && { [ "$nr_family" = -4 ] || [ -n "$nr_addr6" ]; }; then
            nr_tunnel=1
        fi
        # The temporary guard, when it's there, is expected until a pass
        # verifies: it only ever blocks forwarding.
        nr_extra=''
        if ip "$nr_family" rule show 2>/dev/null | awk -v iface="$OVERLAY_IF" '
                $1 == "80:" && $2 == "from" && $3 == "all" && $4 == "iif" && $5 == iface &&
                ((NF == 6 && $6 == "unreachable") || (NF == 7 && $6 == "[detached]" && $7 == "unreachable")) { f = 1 }
                END { exit !f }'; then
            nr_extra=$window
        fi
        nr_actions=$(rule_actions "$nr_family" "$(native_expected "$nr_family" "$gl_address" "$nr_extra")" native "$nr_skip")
        if [ -n "$nr_actions" ]; then
            nr_changed=1
            if printf '%s\n' "$nr_actions" | grep -q '^[a-z]* 9[0-7]\( \|$\)'; then
                if [ -z "$nr_extra" ]; then
                    ip "$nr_family" rule add iif "$OVERLAY_IF" unreachable priority 80 ||
                        echo "10-exit-routing: could not add the IPv${nr_family#-} temporary guard" >&2
                    nr_extra=$window
                fi
            fi
            apply_rule_actions "$nr_family" "$(native_expected "$nr_family" "$gl_address" "$nr_extra")" '' native "$nr_skip"
        fi
        if [ -n "$(exit_table_actions "$nr_family" "$nr_tunnel")" ]; then
            nr_changed=1
            apply_exit_table "$nr_family" "$nr_tunnel"
        fi
        if [ -n "$(native_problems "$nr_family" "$gl_address" "$nr_rule94" "$nr_tunnel" "$nr_extra")" ]; then
            nr_bad=1
            echo "10-exit-routing: IPv${nr_family#-} routing still differs after repair; the temporary guard stays if it is in" >&2
            continue
        fi
        if [ -n "$nr_extra" ]; then
            while ip "$nr_family" rule del iif "$OVERLAY_IF" unreachable priority 80 2>/dev/null; do :; done
            [ -z "$(native_problems "$nr_family" "$gl_address" "$nr_rule94" "$nr_tunnel")" ] || nr_bad=1
        fi
    done
    [ "$nr_bad" = 0 ] || return 1
    [ "$nr_changed" = 0 ] || return 3
    return 0
}

case "${1:-}" in
    --reconcile)
        nr_status=0
        native_reconcile || nr_status=$?
        exit "$nr_status" ;;
    ''|--install) : ;;
    *) fail "unknown argument (use --install or --reconcile)" ;;
esac

# The tunnel addresses come from the same file wg-quick will use, so the
# return-path rules can exist before the interface does. Only the Address
# line is read; the file also holds the private key and is never echoed.
TUNNEL_CONF="${TUNNEL_CONF:-/config/wg_confs/$EXIT_IF.conf}"
[ -f "$TUNNEL_CONF" ] || fail "tunnel configuration is missing (expected $EXIT_IF.conf under wg_confs)"
tunnel4=''
tunnel6=''
for entry in $(sed -n 's/^[[:space:]]*Address[[:space:]]*=[[:space:]]*//p' "$TUNNEL_CONF" \
        | tr ',' '\n' | sed 's/[[:space:]]//g; s#/.*$##; /^$/d'); do
    case "$entry" in
        *:*)
            case "$entry" in *[!0-9a-fA-F:]*) fail "invalid IPv6 tunnel address" ;; esac
            [ "${#entry}" -le 39 ] || fail "invalid IPv6 tunnel address"
            [ -z "$tunnel6" ] || fail "tunnel configuration must have exactly one IPv6 Address"
            tunnel6=$entry ;;
        *)
            parse_ipv4 "$entry"
            [ -z "$tunnel4" ] || fail "tunnel configuration must have exactly one IPv4 Address"
            tunnel4=$entry ;;
    esac
done
case "$PROVIDER" in
    mullvad) [ -n "$tunnel4" ] || fail "tunnel configuration needs an IPv4 Address" ;;
    # PIA assigns the tunnel address per server; the applier sets it and its
    # return-path rules when it registers the key. The guards below still apply.
    pia) [ -z "$tunnel6" ] || fail "PIA tunnels carry no IPv6; remove the IPv6 Address" ;;
    # NordLynx: one IPv4 address on every server, and no IPv6.
    nordvpn)
        [ -n "$tunnel4" ] || fail "tunnel configuration needs an IPv4 Address"
        [ -z "$tunnel6" ] || fail "NordVPN tunnels carry no IPv6; remove the IPv6 Address" ;;
    *) fail "PROVIDER must be mullvad, pia or nordvpn" ;;
esac
if [ "$(cat /proc/sys/net/ipv4/icmp_errors_use_inbound_ifaddr 2>/dev/null)" != 1 ]; then
    echo "10-exit-routing: warning: net.ipv4.icmp_errors_use_inbound_ifaddr is not 1; set it in compose.yaml or IPv4 path MTU discovery through the exit will fail" >&2
fi

install_local_guard
# These priorities are owned by Molebridge in this dedicated namespace.
# Never remove the temporary guard if any later command fails.
for family in -4 -6; do
    ip "$family" rule add iif "$OVERLAY_IF" unreachable priority 80
    ip "$family" route replace unreachable default metric 4096 table "$EXIT_TABLE"
done
for family in -4 -6; do
    for priority in 90 94 95 96 97 98; do
        while ip "$family" rule del priority "$priority" 2>/dev/null; do :; done
    done
    cidr=$OVERLAY_CIDR
    tunnel=$tunnel4
    icmp=icmp
    if [ "$family" = -6 ]; then
        cidr=$OVERLAY6_CIDR
        tunnel=$tunnel6
        icmp=ipv6-icmp
    fi
    if [ -n "$cidr" ]; then
        # Only tunnel replies may use the main table for overlay destinations.
        ip "$family" rule add iif "$EXIT_IF" to "$cidr" lookup main priority 90
    fi
    if [ -n "$tunnel" ]; then
        # ICMP errors the exit generates for tunnel traffic carry the tunnel
        # address and must go back through the tunnel; with it down they hit
        # the unreachable fallback instead of the host's default route. The
        # protocol qualifier keeps the rule to its stated purpose: without it
        # every protocol sourced from the tunnel address is forced into the
        # tunnel, including traffic from anything else sharing the namespace.
        ip "$family" rule add from "$tunnel" ipproto "$icmp" lookup "$EXIT_TABLE" priority 94
        # The backstop: the same packets are unreachable if 94 or the exit
        # table's routes are ever gone.
        ip "$family" rule add from "$tunnel" ipproto "$icmp" unreachable priority 98
    fi
    ip "$family" rule add iif "$OVERLAY_IF" lookup "$EXIT_TABLE" priority 95
    ip "$family" rule add oif "$EXIT_IF" lookup "$EXIT_TABLE" priority 96
    ip "$family" rule add iif "$OVERLAY_IF" unreachable priority 97
done
for family in -4 -6; do
    while ip "$family" rule del iif "$OVERLAY_IF" unreachable priority 80 2>/dev/null; do :; done
done
[ "${1:-}" = --install ] || touch "$READY_FILE"
echo "10-exit-routing: rules installed (1/90/94/95/96/97/98, protected table)"
