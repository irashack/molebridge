#!/usr/bin/env sh
# Runtime restarts do not honor Compose depends_on. Check this namespace
# before handing off to the pinned image's original NetBird entrypoint.
#
# First refuse NetBird settings Molebridge does not support: it needs kernel
# WireGuard, NetBird's kernel firewall, daemon mode and the default profile,
# without Rosenpass. Then wait until both address families have
# the terminal guard (priority 97) and the local-delivery guard (priority 1),
# with no other `lookup local` rule that could match the overlay interface.
# NetBird source references are to the pinned release, 0.79.0.
#
# With TUNNEL_BACKEND=gluetun the gate also refuses settings that switch off
# NetBird's control-plane mark, waits for the control-plane rules (88/89) and
# the host table, and then stays in front of NetBird instead of handing over:
# it stops NetBird, and exits non-zero, when NetBird logs that it runs without
# advanced routing, when the overlay interface has not carried the control
# mark for 30 seconds, or when the guards stay missing for 30 seconds.
set -eu
set -f
overlay_if=${NB_INTERFACE_NAME:-wt0}
case "$overlay_if" in
    ''|[!a-zA-Z0-9_]*|*[!a-zA-Z0-9_.-]*) echo 'NetBird gate: invalid interface name' >&2; exit 1 ;;
esac
[ "${#overlay_if}" -le 15 ] && [ "$#" -gt 0 ] || exit 1
backend=${TUNNEL_BACKEND:-wireguard}
case "$backend" in
    wireguard|gluetun) : ;;
    *) echo 'NetBird gate: TUNNEL_BACKEND must be wireguard or gluetun' >&2; exit 1 ;;
esac

refuse() {
    echo "NetBird gate: refusing to start NetBird: $1 (see docs/troubleshooting.md)" >&2
    exit 1
}
# Go's strconv.ParseBool true values, used by the switches NetBird parses
# that way (client/firewall/create_linux.go:231-239,
# client/firewall/uspfilter/filter.go:512-519, and pflag for `netbird up`).
truthy() {
    case "$1" in 1|t|T|TRUE|true|True) return 0 ;; *) return 1 ;; esac
}
must_be_off() {
    if truthy "$2"; then refuse "$1 is set; $3"; fi
}
# NetBird enables these two only on the exact value "true".
must_not_be_true() {
    if [ "$2" = true ]; then refuse "$1 is set; $3"; fi
}

# Validate supported runtime settings: kernel WireGuard and NetBird's kernel
# firewall (client/iface/netstack/env.go:14,33-35;
# client/iface/device/kernel_module_linux.go:37,89-92).
kernel_needed="Molebridge needs kernel WireGuard and NetBird's kernel firewall"
must_be_off NB_FORCE_USERSPACE_FIREWALL "${NB_FORCE_USERSPACE_FIREWALL:-}" "$kernel_needed"
must_be_off NB_FORCE_USERSPACE_ROUTER "${NB_FORCE_USERSPACE_ROUTER:-}" "$kernel_needed"
must_not_be_true NB_USE_NETSTACK_MODE "${NB_USE_NETSTACK_MODE:-}" "$kernel_needed"
must_not_be_true NB_WG_KERNEL_DISABLED "${NB_WG_KERNEL_DISABLED:-}" "$kernel_needed"
# compose.yaml sets this; it is part of the supported configuration.
truthy "${NB_DISABLE_USERSPACE_ROUTING:-}" ||
    refuse 'NB_DISABLE_USERSPACE_ROUTING must be "true" (compose.yaml sets it)'
# Rosenpass is not supported on the exit: its key exchange needs local
# delivery from the overlay. `netbird up` reads NB_ENABLE_ROSENPASS and the
# older WT_ name (client/cmd/root.go:220,245-267; client/cmd/up.go:99-100).
must_be_off NB_ENABLE_ROSENPASS "${NB_ENABLE_ROSENPASS:-}" 'Rosenpass cannot work on this exit'
must_be_off WT_ENABLE_ROSENPASS "${WT_ENABLE_ROSENPASS:-}" 'Rosenpass cannot work on this exit'
# Foreground mode runs NetBird inside `netbird up`, with the profile chosen
# there instead of the daemon's (client/cmd/up.go:72,99-100,143-150,203-240).
must_be_off NB_FOREGROUND_MODE "${NB_FOREGROUND_MODE:-}" "Molebridge supports only NetBird's daemon mode"
must_be_off WT_FOREGROUND_MODE "${WT_FOREGROUND_MODE:-}" "Molebridge supports only NetBird's daemon mode"
# `netbird up` takes the interface name from NB_INTERFACE_NAME, and from
# WT_INTERFACE_NAME when NB_ is unset (client/cmd/up.go:73,
# client/cmd/root.go:245-267). Both must name the guarded interface.
if [ -n "${NB_INTERFACE_NAME+set}" ] && [ -z "$NB_INTERFACE_NAME" ]; then
    refuse 'NB_INTERFACE_NAME is empty'
fi
if [ -n "${WT_INTERFACE_NAME+set}" ] && [ "$WT_INTERFACE_NAME" != "$overlay_if" ]; then
    refuse "WT_INTERFACE_NAME is set and differs from the guarded interface $overlay_if"
fi
# Only NetBird's default profile, at its default location, is supported: the
# checks below read that one. NB_CONFIG and WT_CONFIG move it
# (client/cmd/root.go:168,245-267); NB_PROFILE and WT_PROFILE make
# `netbird up` switch to another (client/cmd/up.go:93,99-100,136-141).
for name in NB_CONFIG WT_CONFIG NB_PROFILE WT_PROFILE; do
    if eval "[ -n \"\${$name+set}\" ]"; then
        refuse "$name is set; Molebridge supports only NetBird's default profile"
    fi
done

# A JSON reader for the checks below; the NetBird image has no JSON tool.
# It validates the whole file as JSON (strings with every escape, numbers,
# literals, nesting) and reports on the root object's own fields only,
# matched as Go's encoding/json matches struct fields: by name, without
# regard to ASCII case (client/util/file.go:196-209). It prints one verdict
# and nothing from the file:
#   malformed  not a single valid JSON object
#   badkey     a root field name with a byte or escape outside printable ASCII
#   duplicate  a checked field appears more than once, in any case
#   rosenpass  (profile) RosenpassEnabled present and not false
#   interface  (profile) WgIface not a string naming the guarded interface;
#              absent or empty means wt0 (client/internal/profilemanager/
#              config.go:397-405, client/iface/configurer/name.go:6)
#   other      (active) the active profile is not "default"
#   ok
# POSIX awk only, run with LC_ALL=C; tools/check-routing.sh runs it under busybox
# awk, mawk and gawk.
json_reader='
function skip_ws(   c) {
    while (pos <= n) {
        c = substr(text, pos, 1)
        if (c == " " || c == "\t" || c == "\n" || c == "\r") pos++
        else break
    }
}
function is_digit(c) { return c != "" && index("0123456789", c) > 0 }
function read_string(   c, e, h, v, k, d) {
    pos++
    str_val = ""
    str_plain = 1
    while (1) {
        if (pos > n) { bad = 1; return }
        c = substr(text, pos, 1)
        if (c == "\"") { pos++; return }
        if (c == "\\") {
            e = substr(text, pos + 1, 1)
            if (e == "\"" || e == "\\" || e == "/") { str_val = str_val e; pos += 2 }
            else if (e == "b" || e == "f" || e == "n" || e == "r" || e == "t") {
                str_val = str_val "?"; str_plain = 0; pos += 2
            } else if (e == "u") {
                h = tolower(substr(text, pos + 2, 4))
                if (length(h) != 4) { bad = 1; return }
                v = 0
                for (k = 1; k <= 4; k++) {
                    d = index(hexdigits, substr(h, k, 1))
                    if (d == 0) { bad = 1; return }
                    v = v * 16 + d - 1
                }
                if (v >= 32 && v < 127) str_val = str_val sprintf("%c", v)
                else { str_val = str_val "?"; str_plain = 0 }
                pos += 6
            } else { bad = 1; return }
            continue
        }
        if (index(control, c)) { bad = 1; return }
        if (!index(printable, c)) str_plain = 0
        str_val = str_val c
        pos++
    }
}
function read_digits(   start) {
    start = pos
    while (is_digit(substr(text, pos, 1))) pos++
    return pos > start
}
function read_number(   c) {
    if (substr(text, pos, 1) == "-") pos++
    c = substr(text, pos, 1)
    if (c == "0") pos++
    else if (is_digit(c)) read_digits()
    else { bad = 1; return }
    if (substr(text, pos, 1) == ".") { pos++; if (!read_digits()) { bad = 1; return } }
    c = substr(text, pos, 1)
    if (c == "e" || c == "E") {
        pos++
        c = substr(text, pos, 1)
        if (c == "+" || c == "-") pos++
        if (!read_digits()) { bad = 1; return }
    }
}
function note_value(type, value, plain) {
    if (depth != 1 || field == "") return
    vtype[field] = type
    vval[field] = value
    vplain[field] = plain
}
function close_container() {
    depth--
    expect = depth == 0 ? "end" : "next"
}
BEGIN {
    for (i = 32; i < 127; i++) printable = printable sprintf("%c", i)
    for (i = 1; i < 32; i++) control = control sprintf("%c", i)
    hexdigits = "0123456789abcdef"
    if (mode == "profile") { checked["wgiface"] = 1; checked["rosenpassenabled"] = 1 }
    else { checked["name"] = 1 }
}
{ text = text $0 "\n" }
END {
    n = length(text)
    pos = 1
    depth = 0
    expect = "value"
    while (!bad) {
        skip_ws()
        if (pos > n) { if (expect != "end") bad = 1; break }
        c = substr(text, pos, 1)
        if (expect == "end") { bad = 1; break }
        if (expect == "colon") {
            if (c != ":") { bad = 1; break }
            pos++
            expect = "value"
            continue
        }
        if (expect == "next") {
            if (c == ",") { pos++; expect = kind[depth] == "o" ? "key" : "value"; continue }
            if ((c == "}" && kind[depth] == "o") || (c == "]" && kind[depth] == "a")) { pos++; close_container(); continue }
            bad = 1
            break
        }
        if (expect == "key" || expect == "key_or_close") {
            if (c == "}" && expect == "key_or_close") { pos++; close_container(); continue }
            if (c != "\"") { bad = 1; break }
            read_string()
            if (bad) break
            if (depth == 1) {
                if (!str_plain) badkey = 1
                field = tolower(str_val)
                if (field in checked) count[field]++
                else field = ""
            }
            expect = "colon"
            continue
        }
        if (c == "]" && expect == "value_or_close") { pos++; close_container(); continue }
        if (c == "{" || c == "[") {
            if (depth == 0 && c == "[") { bad = 1; break }
            note_value(c == "{" ? "object" : "array", "", 1)
            depth++
            kind[depth] = c == "{" ? "o" : "a"
            pos++
            expect = c == "{" ? "key_or_close" : "value_or_close"
            continue
        }
        if (depth == 0) { bad = 1; break }
        if (c == "\"") {
            read_string()
            if (bad) break
            note_value("string", str_val, str_plain)
        } else if (substr(text, pos, 4) == "true") { pos += 4; note_value("true", "", 1) }
        else if (substr(text, pos, 5) == "false") { pos += 5; note_value("false", "", 1) }
        else if (substr(text, pos, 4) == "null") { pos += 4; note_value("null", "", 1) }
        else if (c == "-" || is_digit(c)) {
            read_number()
            if (bad) break
            note_value("number", "", 1)
        } else { bad = 1; break }
        expect = "next"
    }
    if (bad) { print "malformed"; exit }
    if (badkey) { print "badkey"; exit }
    for (f in count) if (count[f] > 1) { print "duplicate"; exit }
    if (mode == "profile") {
        if (count["rosenpassenabled"] && vtype["rosenpassenabled"] != "false") { print "rosenpass"; exit }
        value = "wt0"
        if (count["wgiface"]) {
            if (vtype["wgiface"] != "string" || !vplain["wgiface"]) { print "interface"; exit }
            if (vval["wgiface"] != "") value = vval["wgiface"]
        }
        if (value != iface) { print "interface"; exit }
    } else if (count["name"]) {
        if (vtype["name"] != "string" || !vplain["name"]) { print "other"; exit }
        if (vval["name"] != "" && vval["name"] != "default") { print "other"; exit }
    }
    print "ok"
}
'
# Prints the reader's verdict for a file, or "unreadable".
read_json() {
    if [ ! -r "$2" ] || ! size=$(wc -c < "$2" | tr -d ' '); then echo unreadable; return; fi
    # A profile is a few kilobytes. awk strings cannot hold NUL bytes, and
    # JSON text never contains one.
    if [ "$size" -gt 1048576 ] || [ "$(tr -d '\000' < "$2" | wc -c | tr -d ' ')" != "$size" ]; then
        echo malformed
        return
    fi
    LC_ALL=C awk -v mode="$1" -v iface="$overlay_if" "$json_reader" < "$2" || echo unreadable
}

# NetBird's daemon loads the active profile at start, and `netbird up` run
# as plain root uses the daemon's choice (client/server/server.go:285-326,
# 1488-1495; client/cmd/up.go:316-336). An absent active_profile.json, or one
# whose name is empty or "default", means the default profile at
# <state>/default.json (client/internal/profilemanager/service.go:65-87,
# 98-118,212-243). No other profile file is read at start, so only these are
# checked: the active-profile state, the default profile, and the legacy
# files NetBird copies into it when it is missing (service.go:142-172;
# client/cmd/root.go:128-148,343-350). The default profile must keep
# Rosenpass off and name the guarded interface. Nothing from the files is
# printed: profiles also hold the peer's private key.
state_dir=${NB_STATE_DIR:-/var/lib/netbird}
active=$state_dir/active_profile.json
if [ -e "$active" ] || [ -L "$active" ]; then
    case "$(read_json active "$active")" in
        ok) ;;
        other) refuse "the active NetBird profile is not the default profile ($active)" ;;
        unreadable) refuse "cannot read the active NetBird profile state $active" ;;
        *) refuse "the active NetBird profile state $active is not a valid JSON object" ;;
    esac
fi
for file in "$state_dir/default.json" /etc/netbird/config.json /etc/wiretrustee/config.json; do
    [ -e "$file" ] || [ -L "$file" ] || continue
    case "$(read_json profile "$file")" in
        ok) ;;
        rosenpass) refuse 'Rosenpass is enabled in a stored NetBird profile (RosenpassEnabled)' ;;
        interface) refuse "a stored NetBird profile ($file) uses a WireGuard interface other than $overlay_if (WgIface)" ;;
        duplicate) refuse "the stored NetBird profile $file repeats WgIface or RosenpassEnabled" ;;
        badkey) refuse "the stored NetBird profile $file has a field name outside printable ASCII" ;;
        unreadable) refuse "cannot read the stored NetBird profile $file" ;;
        *) refuse "the stored NetBird profile $file is not a valid JSON object" ;;
    esac
done

guard_present() {
    # iproute2 marks a selector detached until NetBird creates the interface.
    # Require the whole terminal rule, not a substring or a narrowed selector,
    # and the exact local-delivery rule. A `lookup local` rule is safe only as
    # that rule (inverted, with the overlay interface as its only selector) or
    # with a positive iif naming another interface. The kernel's own
    # priority-0 rule is neither.
    rules=$(ip "$1" rule show 2>/dev/null) || return 1
    printf '%s\n' "$rules" | awk -v iface="$overlay_if" '
        $1 == "97:" && $2 == "from" && $3 == "all" && $4 == "iif" && $5 == iface {
            if ((NF == 6 && $6 == "unreachable") ||
                (NF == 7 && $6 == "[detached]" && $7 == "unreachable")) terminal = 1
        }
        {
            local_lookup = 0
            iif = ""
            for (i = 2; i < NF; i++) {
                if ($i == "lookup" && $(i + 1) == "local") local_lookup = 1
                if ($i == "iif") iif = $(i + 1)
            }
            if (!local_lookup) next
            overlay_only = $2 == "not" && $3 == "from" && $4 == "all" && $5 == "iif" && $6 == iface &&
                           ((NF == 8 && $7 == "lookup") || (NF == 9 && $7 == "[detached]" && $8 == "lookup"))
            if (overlay_only) {
                if ($1 == "1:") guarded = 1
            } else if ($2 == "not" || iif == "" || iif == iface) {
                exposed = 1
            }
        }
        END { exit !(terminal && guarded && !exposed) }
    '
}

if [ "$backend" = gluetun ]; then
    # Rules 88 and 89 send NetBird's control traffic to the host table by its
    # socket mark; an unmarked socket falls through to gluetun's rule 101 and
    # into the provider tunnel. NetBird marks its sockets only with advanced
    # routing, which these switch off (client/net/env_linux.go:34-73,
    # client/net/env.go:12-35; netstack mode is refused above).
    unmarked='the gluetun backend needs NetBird to mark its control traffic'
    must_be_off NB_USE_LEGACY_ROUTING "${NB_USE_LEGACY_ROUTING:-}" "$unmarked"
    must_be_off NB_SKIP_SOCKET_MARK "${NB_SKIP_SOCKET_MARK:-}" "$unmarked"
    must_be_off NB_DISABLE_CUSTOM_ROUTING "${NB_DISABLE_CUSTOM_ROUTING:-}" "$unmarked"
    control_mark=${CONTROL_MARK:-0x1bd00}
    case "$control_mark" in
        0x*[!0-9a-f]*) refuse 'CONTROL_MARK must be lowercase hexadecimal like 0x1bd00' ;;
        0x[1-9a-f]*00) [ "${#control_mark}" -le 10 ] || refuse 'CONTROL_MARK must fit in 32 bits' ;;
        *) refuse 'CONTROL_MARK must be lowercase hexadecimal like 0x1bd00, low byte zero' ;;
    esac
    # NetBird moves its whole mark range with NB_FWMARK_BASE and treats an
    # empty value as unset (client/net/fwmark.go:17-21,75-110). Require the
    # exact text, so no parsing difference can separate the two.
    [ "${NB_FWMARK_BASE:-0x1bd00}" = "$control_mark" ] ||
        refuse "NB_FWMARK_BASE must equal CONTROL_MARK ($control_mark)"
    # The whole guard is checked with the definitions the guard sidecar uses
    # (routing/gluetun-rules, mounted next to this script), with the same
    # settings: every rule at priorities 0-97, the exit table and the host
    # table, in both families.
    OVERLAY_IF=$overlay_if
    OVERLAY_CIDR=${OVERLAY_CIDR:-}
    OVERLAY6_CIDR=${OVERLAY6_CIDR:-}
    EXIT_IF=${EXIT_IF:-wg0}
    EXIT_TABLE=${EXIT_TABLE:-51821}
    HOST_IF=${HOST_IF:-eth0}
    HOST_TABLE=${HOST_TABLE:-51822}
    CONTROL_MARK=$control_mark
    host_table=$HOST_TABLE
    GLUETUN_RULES=${GLUETUN_RULES:-/usr/local/bin/molebridge-gluetun-rules}
    [ -f "$GLUETUN_RULES" ] || refuse "the guard's rule definitions are missing ($GLUETUN_RULES)"
    fail() { refuse "$1"; }
    # shellcheck source=routing/gluetun-rules
    . "$GLUETUN_RULES"
    gr_validate
    # NetBird writes its log to the files in NB_LOG_FILE as well as the console
    # (the image's entrypoint sets this default).
    watch_log=''
    old_ifs=$IFS
    IFS=,
    for entry in ${NB_LOG_FILE:-console,/var/log/netbird/client.log}; do
        case "$entry" in /*) [ -n "$watch_log" ] || watch_log=$entry ;; esac
    done
    IFS=$old_ifs
    [ -n "$watch_log" ] || refuse 'NB_LOG_FILE must name a log file; the gate reads it'
    # The routing sidecar writes "<boot id> <boot-clock seconds> <wg show
    # fwmark>" here. Every deadline below runs on the kernel's boot clock,
    # which wall-clock changes don't move (gr_clock in routing/gluetun-rules).
    status_file=${GUARD_STATUS_FILE:-/run/molebridge/overlay-fwmark}
    gr_clock || refuse 'cannot read the boot clock (/proc/uptime and the boot id)'

    # The guard rewrites the record every 2 seconds and this loop reads it
    # every 2, in whole seconds: 5 is the shortest grace that a healthy exit
    # always meets.
    grace=${FWMARK_GRACE:-30}
    case "$grace" in ''|0*|*[!0-9]*) refuse 'FWMARK_GRACE must be 5..30 seconds' ;; esac
    [ "${#grace}" -le 2 ] && [ "$grace" -ge 5 ] && [ "$grace" -le 30 ] || refuse 'FWMARK_GRACE must be 5..30 seconds'
fi

if [ "$1" = --check-config ]; then
    echo 'NetBird gate: configuration accepted'
    exit 0
fi

guards_ready() {
    guard_present -4 && guard_present -6 || return 1
    [ "$backend" = gluetun ] || return 0
    [ -z "$(gr_problems -4 '')" ] && [ -z "$(gr_problems -6 '')" ]
}
# What is still missing, for the log while the gate waits.
guard_problems() {
    found=''
    for family in -4 -6; do
        guard_present "$family" || found="$found IPv${family#-}: rule 1 or 97;"
        [ "$backend" = gluetun ] || continue
        for problem in $(gr_problems "$family" ''); do
            case "$problem" in
                rules) found="$found IPv${family#-}: rules;" ;;
                exit) found="$found IPv${family#-}: exit table $EXIT_TABLE;" ;;
                host) found="$found IPv${family#-}: host table $host_table;" ;;
                nodefault) found="$found IPv4: no default route through $HOST_IF in the main table;" ;;
            esac
        done
    done
    if [ "$backend" = gluetun ] && ! ip link show dev "$HOST_IF" >/dev/null 2>&1; then
        found="$found $HOST_IF is not in this namespace (gluetun restarted into a new one? recreate the stack);"
    fi
    printf '%s' "${found:- nothing now}"
}

trap 'exit 0' INT TERM
echo 'NetBird gate: waiting for IPv4 and IPv6 routing guards'
[ "$backend" = wireguard ] ||
    echo "NetBird gate: gluetun backend: waiting for the whole guard (rules 1-97 with control mark $control_mark, exit table $EXIT_TABLE, host table $host_table)"
waited=0
until guards_ready; do
    waited=$((waited + 1))
    # Say why every 30 seconds instead of waiting silently; the guard's own
    # log has the details.
    if [ $((waited % 30)) -eq 0 ]; then
        echo "NetBird gate: still waiting after ${waited} s:$(guard_problems)" >&2
    fi
    sleep 1
done
[ "$backend" = gluetun ] || exec "$@"

# gluetun: supervise NetBird instead of handing over.
log_size() {
    size=$({ wc -c < "$watch_log"; } 2>/dev/null) || size=0
    size=$(printf '%s' "$size" | tr -d ' ')
    case "$size" in ''|*[!0-9]*) size=0 ;; esac
    printf '%s' "$size"
}
now() {
    gr_clock || stop 'cannot read the boot clock'
}
launch_offset=$(log_size)
offset=$launch_offset
gr_clock || refuse 'cannot read the boot clock'
launched=$gr_now
boot=$gr_boot
last_good=$launched
guards_lost=''
"$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null || :; wait "$child" 2>/dev/null || :; exit 0' INT TERM
stop() {
    echo "NetBird gate: stopping NetBird: $1 (see docs/troubleshooting.md)" >&2
    kill -TERM "$child" 2>/dev/null || :
    waited=0
    while kill -0 "$child" 2>/dev/null && [ "$waited" -lt 20 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    kill -KILL "$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
    exit 1
}
echo "NetBird gate: NetBird started; watching its log and $overlay_if's fwmark"
while :; do
    if ! kill -0 "$child" 2>/dev/null; then
        status=0
        wait "$child" || status=$?
        echo "NetBird gate: NetBird exited with status $status" >&2
        exit "$status"
    fi
    # NetBird logs one of these when it will not mark its sockets
    # (client/net/env_linux.go:61,66). Read only what this launch wrote; keep
    # an overlap so a line written across two reads is still seen whole.
    size=$(log_size)
    [ "$size" -ge "$offset" ] || { offset=0; launch_offset=0; }
    if tail -c +"$((offset + 1))" "$watch_log" 2>/dev/null |
            grep -Fq -e 'falling back to legacy routing' -e 'advanced routing has been requested to be disabled'; then
        stop 'NetBird logged that it runs without advanced routing, so its control traffic would be unmarked'
    fi
    offset=$((size > launch_offset + 512 ? size - 512 : launch_offset))
    now
    [ "$gr_boot" = "$boot" ] || stop 'the boot clock changed identity'
    # A good record counts from when it was written, so reading the same
    # record again never extends it. Records from another boot, from before
    # this launch or from the future count for nothing.
    record_boot=''
    stamp=''
    value=''
    { read -r record_boot stamp value < "$status_file"; } 2>/dev/null || :
    case "$stamp" in ''|*[!0-9]*) stamp=0 ;; esac
    [ "${#stamp}" -le 12 ] || stamp=0
    if [ "$record_boot" = "$boot" ] && [ "$stamp" -ge "$last_good" ] && [ "$stamp" -le "$gr_now" ] &&
            [ "$value" = "$control_mark" ]; then
        last_good=$stamp
    fi
    [ $((gr_now - last_good)) -le "$grace" ] ||
        stop "$overlay_if has not carried the control mark $control_mark for $grace seconds (last reported: ${value:-nothing})"
    if guards_ready; then
        guards_lost=''
    else
        guards_lost=${guards_lost:-$gr_now}
        [ $((gr_now - guards_lost)) -le "$grace" ] ||
            stop "routing guards missing for $grace seconds:$(guard_problems)"
    fi
    sleep 2 &
    wait "$!" || :
done
