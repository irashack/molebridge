{{/*
The .env `molebridge init` writes beside its compose.yaml, one per form: the
settings of the matching shipped example (.env.example,
.env.gluetun.example, .env.sidecar.example, .env.native-sidecar.example)
with their values, less COMPOSE_FILE (init's file is compose.yaml, which
Compose reads by itself), the panel's settings when there is no Switchyard,
and the proxy's when there is one. TestEnvMatchesExamples fails when a
setting here and its example drift apart. It holds no secrets.
*/}}
{{define "head"}}# Written by `molebridge init` (experimental, docs/setup.md#molebridge-init)
# beside compose.yaml. This file holds no secrets; every setting is described
# in docs/configuration.md.
{{end}}
{{define "panel"}}
# Switchyard, the panel, published on 127.0.0.1 only.
PANEL_PORT=8095
# Names the panel is served under, comma-separated: the public hostname behind
# your proxy and, if the proxy rewrites the upstream Host, that name with its
# port. Loopback is always accepted.
PANEL_PUBLIC_HOSTS={{.PanelHosts}}
{{- if .PanelExits}}
# Several exits in one panel, as id=provider[/kind][:label] (docs/switchyard.md).
# Empty: this exit only.
PANEL_EXITS=
{{- end}}
# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
# Leave PANEL_OIDC_ISSUER empty for no login; with one, also set the three below.
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=
{{end}}
{{define "proxy"}}
# The proxy (experimental, drilled live on Mullvad only: docs/proxy.md).
# Every connection it opens leaves through the tunnel, or fails. It promises
# nothing about traffic not sent to it. It listens on one address in the
{{- if eq .Form "overlay"}}
# exit's namespace: set the exit's NetBird address and a port (e.g.
# 192.0.2.10:1080) for devices on the overlay; loopback reaches nothing here.
{{- else}}
# exit's namespace: loopback, for the containers that share the namespace.
{{- end}}
# Its password goes in secrets/proxy/password, one line, mode 0600.
PROXY_LISTEN=127.0.0.1:1080
{{end}}
{{define "tail"}}
# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
TZ=Etc/UTC
{{end}}
{{define "overlay"}}{{template "head" .}}
# VPN provider: mullvad, pia or nordvpn. Keep it unchanged after installation
# (docs/providers.md).
PROVIDER={{.Provider}}
# The tunnel interface, and the name of its config under tunnel/wg_confs/:
# the same as PROVIDER unless you chose another name.
EXIT_IF={{.Provider}}
# Optional server hostname (PIA: region id). When set, configuration wins:
# the exit ignores panel requests and the panel shows this exit read-only.
SERVER=
{{- if eq .Provider "pia"}}
# PIA only: forward one port to one overlay device. Off unless you need it.
PIA_PORT_FORWARD=off
PIA_PORT_FORWARD_TARGET=
{{- end}}

# NetBird account's peer network range (required) and IPv6 overlay range (if enabled).
# Documentation-only example: replace with your account's actual range.
OVERLAY_CIDR=192.0.2.0/24
OVERLAY6_CIDR=

# NetBird peer name and management server (NetBird Cloud by default).
NB_HOSTNAME=molebridge-exit
NB_MANAGEMENT_URL=https://api.netbird.io
{{if .Switchyard}}{{template "panel" .}}{{end}}{{if .Proxy}}{{template "proxy" .}}{{end}}{{template "tail" .}}
# Overrides you may add, each documented with its default in
# docs/configuration.md: COMPOSE_PROJECT_NAME (keep it unchanged once the exit
# has started), PANEL_USER and PANEL_ALLOW_ROOT (a rootless engine that remaps
# uids), PANEL_TITLE, PANEL_HOST_LABEL, PANEL_THEME, PANEL_STYLE,
# PANEL_FRAME_ANCESTORS, PANEL_HOME_URL, PANEL_SESSION_TTL, OVERLAY_IF,
# EXIT_TABLE, ROUTING_RECONCILE_INTERVAL, GUARD_GRACE and GATUS_ENDPOINT.
{{- if .Proxy}}
# The proxy: PROXY_MAX_CONNS (512) and PROXY_DNS (the provider's resolver).
{{- end}}
{{end}}
{{define "gluetun-overlay"}}{{template "head" .}}
# gluetun's provider id (docs/configuration.md#gluetun-backend).
GLUETUN_PROVIDER={{.GluetunProvider}}
# gluetun's tunnel interface (VPN_INTERFACE): letters, digits and underscores.
# NetBird's ICE blacklist uses the same name.
EXIT_IF=wg0
# The tunnel address your provider assigned, if it needs one (most do; NordVPN does not).
GLUETUN_WIREGUARD_ADDRESSES=
# The server gluetun starts with, comma-separated (see gluetun's provider
# pages); SERVER takes over when set, otherwise the panel's selection does.
# For the first start set only the country, your own (e.g. Netherlands): gluetun's built-in
# list may be old, and a hostname or city missing from it stops gluetun.
GLUETUN_SERVER_COUNTRIES=
GLUETUN_SERVER_CITIES=
GLUETUN_SERVER_HOSTNAMES=
# Optional server hostname from gluetun's list. When set, configuration wins:
# the exit ignores panel requests and the panel shows the server read-only.
SERVER=
# The namespace's interface toward the host: eth0 on Docker; under rootless
# Podman with pasta, the host's own interface name.
HOST_IF=eth0

# NetBird account's peer network range (required) and IPv6 overlay range (if enabled).
# Documentation-only example: replace with your account's actual range.
OVERLAY_CIDR=192.0.2.0/24
OVERLAY6_CIDR=
# NetBird peer name and management server (NetBird Cloud by default).
NB_HOSTNAME=molebridge-exit
NB_MANAGEMENT_URL=https://api.netbird.io
{{if .Switchyard}}{{template "panel" .}}{{end}}{{template "tail" .}}
# Overrides you may add, each documented with its default in
# docs/configuration.md: GLUETUN_UPDATER_PERIOD, HOST_TABLE, CONTROL_MARK
# (NetBird's control-plane mark, NB_FWMARK_BASE), NB_WIREGUARD_PORT,
# FWMARK_GRACE, GUARD_GRACE, ROUTING_RECONCILE_INTERVAL, OVERLAY_IF,
# EXIT_TABLE, COMPOSE_PROJECT_NAME (keep it unchanged once the exit has
# started), PANEL_USER and PANEL_ALLOW_ROOT, and the PANEL_* styling settings.
{{end}}
{{define "gluetun-sidecar"}}{{template "head" .}}
# Your applications go in a Compose file of your own, added here:
#   COMPOSE_FILE=compose.yaml:compose.apps.yaml
# The example profile runs example-app, which only sleeps; remove it once
# yours are in.
COMPOSE_PROFILES=example
# The Compose services of the applications that use the tunnel,
# comma-separated, each with `network_mode: service:gluetun`. A record only:
# nothing reads it. The attachment check in docs/operations.md checks the
# containers you name on its command line.
SIDECAR_APPS=example-app

# gluetun's provider id (docs/gluetun-sidecar.md). Only Mullvad and NordVPN
# confirm egress; with the others the panel shows a switch as unverified.
GLUETUN_PROVIDER={{.GluetunProvider}}
# gluetun's tunnel interface (VPN_INTERFACE): letters, digits and underscores.
EXIT_IF=wg0
# The tunnel address your provider assigned, if it needs one (most do; NordVPN does not).
GLUETUN_WIREGUARD_ADDRESSES=
# The server gluetun starts with, comma-separated (see gluetun's provider
# pages); SERVER takes over when set, otherwise the panel's selection does.
# For the first start set only the country: gluetun's built-in list may be
# old, and a hostname or city missing from it stops gluetun.
GLUETUN_SERVER_COUNTRIES=
GLUETUN_SERVER_CITIES=
GLUETUN_SERVER_HOSTNAMES=
# Ports your applications listen on, opened in gluetun's firewall,
# comma-separated. Publish them on the gluetun service. Never 8000.
GLUETUN_FIREWALL_INPUT_PORTS=
# Optional server hostname from gluetun's list. When set, configuration wins:
# the exit ignores panel requests and the panel shows the server read-only.
SERVER=
{{if .Switchyard}}{{template "panel" .}}{{end}}{{template "tail" .}}
# Overrides you may add, each documented with its default in
# docs/configuration.md: GLUETUN_UPDATER_PERIOD, GUARD_GRACE,
# COMPOSE_PROJECT_NAME (keep it unchanged once the exit has started),
# PANEL_USER and PANEL_ALLOW_ROOT (a rootless engine that remaps uids), and
# the PANEL_* styling settings.
{{end}}
{{define "native-sidecar"}}{{template "head" .}}
# Your applications go in a Compose file of your own, added here:
#   COMPOSE_FILE=compose.yaml:compose.apps.yaml
# The example profile runs example-app, which only sleeps; remove it once
# your applications are in.
COMPOSE_PROFILES=example

# mullvad, pia or nordvpn (docs/providers.md).
PROVIDER={{.Provider}}
# The tunnel interface, and the name of its config under tunnel/wg_confs/.
EXIT_IF={{.Provider}}
# Where your applications may go outside the tunnel, comma-separated IPv4 and
# IPv6 prefixes: the engine's network (for published ports and neighbours) and
# a resolver if it lives there (docs/native-sidecar.md#dns). Documentation-only
# example: replace with your own.
SIDECAR_LAN_CIDRS=198.51.100.0/24
# Optional: resolvers for the exit's own lookups (bare addresses, at most 3),
# when the namespace's resolvers are reachable only through the tunnel.
SIDECAR_HOST_RESOLVERS=
# Optional server hostname (PIA: region id). When set, configuration wins:
# the exit ignores panel requests and the panel shows it read-only.
SERVER=
{{- if eq .Provider "pia"}}
# PIA only: forward one port to this namespace (docs/native-sidecar.md#port-forwarding).
{{- if .PortSync}}
# On, because port-sync needs the forwarded port.
PIA_PORT_FORWARD=on
# Where port-sync reaches qBittorrent's Web API, on the namespace's loopback.
PORT_SYNC_URL=http://127.0.0.1:8080
{{- else}}
PIA_PORT_FORWARD=off
{{- end}}
{{- end}}
{{if .Switchyard}}{{template "panel" .}}{{end}}{{if .Proxy}}{{template "proxy" .}}{{end}}{{template "tail" .}}
# Overrides you may add, each documented with its default in
# docs/configuration.md: HOST_IF, EXIT_TABLE, ROUTING_RECONCILE_INTERVAL,
# GUARD_GRACE, GATUS_ENDPOINT, COMPOSE_PROJECT_NAME (keep it unchanged once the
# exit has started), PANEL_USER and PANEL_ALLOW_ROOT (a rootless engine that
# remaps uids), PANEL_EXITS, PANEL_FRAME_ANCESTORS, PANEL_SESSION_TTL, and the
# styling settings PANEL_TITLE, PANEL_SHORT_TITLE, PANEL_HOST_LABEL,
# PANEL_HOME_URL, PANEL_HOME_LABEL, PANEL_THEME and PANEL_STYLE.
{{- if .Proxy}}
# The proxy: PROXY_MAX_CONNS (512) and PROXY_DNS (the provider's resolver).
{{- end}}
{{end}}
