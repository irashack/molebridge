# Copy to .env for the native sidecar (experimental, docs/native-sidecar.md).
# This file holds no secrets.
COMPOSE_FILE=compose.native-sidecar.yaml

# Your applications go in a Compose file of your own, added here:
#   COMPOSE_FILE=compose.native-sidecar.yaml:compose.apps.yaml
# The example profile runs example-app, which only sleeps; port-sync keeps
# qBittorrent's listening port on PIA's forwarded port. Remove example once
# your applications are in.
COMPOSE_PROFILES=example

# mullvad, pia or nordvpn (docs/providers.md).
PROVIDER=pia
# The tunnel interface, and the name of its config under tunnel/wg_confs/.
EXIT_IF=pia
# Where your applications may go outside the tunnel, comma-separated IPv4 and
# IPv6 prefixes: the engine's network (for published ports and neighbours) and
# a resolver if it lives there (docs/native-sidecar.md#dns). Documentation-only
# example: replace with your own.
SIDECAR_LAN_CIDRS=198.51.100.0/24
# Optional: resolvers for the exit's own lookups (bare addresses, at most 3),
# when the namespace's resolvers are reachable only through the tunnel.
SIDECAR_HOST_RESOLVERS=
# Optional server hostname (PIA: region id). When set, configuration wins:
# the exit ignores panel requests and the panel shows it read-only.
SERVER=
# PIA only: forward one port to this namespace (docs/native-sidecar.md#port-forwarding).
PIA_PORT_FORWARD=off
# Where port-sync reaches qBittorrent's Web API, on the namespace's loopback.
PORT_SYNC_URL=http://127.0.0.1:8080

# Switchyard, the panel, published on 127.0.0.1 only.
PANEL_PORT=8095
PANEL_PUBLIC_HOSTS=
# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=
# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
TZ=Etc/UTC

# Overrides you may add, each documented with its default in
# docs/configuration.md: HOST_IF, EXIT_TABLE, ROUTING_RECONCILE_INTERVAL,
# GUARD_GRACE, GATUS_ENDPOINT, COMPOSE_PROJECT_NAME (keep it unchanged once the
# exit has started), PANEL_USER and PANEL_ALLOW_ROOT (a rootless engine that
# remaps uids), PANEL_EXITS, PANEL_FRAME_ANCESTORS, PANEL_SESSION_TTL, and the
# styling settings PANEL_TITLE, PANEL_SHORT_TITLE, PANEL_HOST_LABEL,
# PANEL_HOME_URL, PANEL_HOME_LABEL, PANEL_THEME and PANEL_STYLE.
