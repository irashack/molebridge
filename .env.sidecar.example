# Copy to .env for the gluetun sidecar (experimental, docs/gluetun-sidecar.md).
# This file holds no secrets.
COMPOSE_FILE=compose.sidecar.yaml
# Deployment identity; keep this unchanged after the first start.
COMPOSE_PROJECT_NAME=molebridge-sidecar

# Your applications go in a Compose file of your own, added here:
#   COMPOSE_FILE=compose.sidecar.yaml:compose.apps.yaml
# The example profile runs compose.sidecar.yaml's example-app, which only
# sleeps; remove it, and example-app below, once yours are in.
COMPOSE_PROFILES=example
# The Compose services of the applications that use the tunnel,
# comma-separated, each with `network_mode: service:gluetun`. The doctor
# fails with no applications declared; recover recreates them with gluetun.
SIDECAR_APPS=example-app

# gluetun's provider id, one the panel can select servers for: fastestvpn,
# ivpn, mullvad, nordvpn, surfshark or windscribe. Only Mullvad and NordVPN
# confirm egress; with the others the panel shows a switch as unverified.
GLUETUN_PROVIDER=nordvpn
# gluetun's tunnel interface (VPN_INTERFACE): letters, digits and underscores.
EXIT_IF=wg0
# The tunnel address your provider assigned, if it needs one (most do; NordVPN does not).
GLUETUN_WIREGUARD_ADDRESSES=
# The server gluetun starts with, comma-separated (see gluetun's provider
# pages); SERVER takes over when set, otherwise the panel's selection does.
# For the first start set only the country: gluetun's built-in list may be
# old, and a hostname or city missing from it stops gluetun.
GLUETUN_SERVER_COUNTRIES=
GLUETUN_SERVER_CITIES=
GLUETUN_SERVER_HOSTNAMES=
# How often gluetun refreshes its server list, which the panel lists. The
# applier also asks for one refresh at start when the list is old; 0: never.
GLUETUN_UPDATER_PERIOD=24h
# Ports your applications listen on, opened in gluetun's firewall,
# comma-separated. Publish them on the gluetun service. Never 8000.
GLUETUN_FIREWALL_INPUT_PORTS=
# Optional server hostname from gluetun's list. When set, configuration wins:
# the applier ignores panel requests and the panel shows the server read-only.
SERVER=

# The panel's user inside its container: your host user's uid:gid on Docker
# (run `id -u` and `id -g`), the user that owns ./state; 0:0 on a rootless
# engine that remaps uids (see docs/configuration.md).
PANEL_USER=1000:1000
TZ=Etc/UTC

# Panel, published on 127.0.0.1 only.
PANEL_PORT=8095
PANEL_PUBLIC_HOSTS=
PANEL_FRAME_ANCESTORS=
PANEL_HOST_LABEL=this gluetun
PANEL_THEME=auto
PANEL_STYLE=provider

# Optional sign-in with OpenID Connect (docs/access.md#sign-in-with-openid-connect).
PANEL_OIDC_ISSUER=
PANEL_OIDC_CLIENT_ID=
PANEL_PUBLIC_URL=
PANEL_ADMIN_GROUPS=
PANEL_SESSION_TTL=3600

# Optional Gatus external endpoint for health pushes (token goes in secrets/applier.env).
GATUS_URL=
GATUS_ENDPOINT=molebridge
